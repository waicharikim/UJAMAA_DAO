# ─────────────────────────────────────────────────────────────────────────────
# UjamaaDAO — PRODUCTION env template
#
# Copy to `docker/.env.prod` on the droplet and fill in real values. The real
# file is gitignored (.env.* is ignored; only *.example is committed) — NEVER
# commit it. The Makefile/aliases load it via `--env-file ../docker/.env.prod`.
#
# Fastest way to populate on the droplet (it already holds all secrets):
#   cp docker/.env docker/.env.prod
# then adjust anything prod-specific below.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core / Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ujamaa_user:CHANGE_ME@postgres:5432/ujamaa_db
POSTGRES_USER=ujamaa_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ujamaa_db

# ── DB backups (docker/backup-db.sh — install: `make prod-backup-cron`) ──────
# Local rolling window lives in $HOME/ujamaa-backups. Set BACKUP_RCLONE_REMOTE to
# an rclone remote (e.g. a DigitalOcean Space) for the OFF-BOX copy that actually
# protects against droplet loss — leave empty and backups are on-box only.
BACKUP_RETENTION_DAYS=14
BACKUP_RCLONE_REMOTE=

BASE_URL=https://api.ujamaadao.org
FRONTEND_URL=https://ujamaadao.org
ALLOWED_ORIGINS=https://ujamaadao.org

# ── Auth / Crypto ────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_min_32_chars
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars   # openssl rand -hex 32

# ── Email (SMTP / Resend) ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ujamaadao.org
RESEND_API_KEY=

# ── SMS (Africa's Talking) ───────────────────────────────────────────────────
ENABLE_SMS=false
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ── M-Pesa (Buni by KCB) ─────────────────────────────────────────────────────
BUNI_BASE_URL=
BUNI_CLIENT_ID=
BUNI_CLIENT_SECRET=
BUNI_B2C_SHORTCODE=
BUNI_B2C_INITIATOR_NAME=
BUNI_B2C_SECURITY_CREDENTIAL=

# ── AI (Baraza bot / deliberation) ───────────────────────────────────────────
# OpenAI-compatible inference. Leave DASHSCOPE_API_KEY empty to disable the AI
# layer entirely (it null-guards → dormant). Provider is switched by URL/key/
# model only — no code change:
#   • Alibaba DashScope (DEFAULT, and required for the Qwen Cloud hackathon):
#     leave DASHSCOPE_BASE_URL empty (→ intl endpoint); models qwen-plus / qwen-max.
#     qwen-plus does NOT "think" by default → fast Q&A bot replies (~1.5s).
#   • DigitalOcean serverless (alternative): DASHSCOPE_BASE_URL=https://inference.do-ai.run/v1;
#     models e.g. alibaba-qwen3-32b, anthropic-claude-5-sonnet. NOTE: the Qwen
#     reasoning models there "think" by default (~14s/reply) — the bot sends
#     reasoning_effort:"none" to disable it, but DashScope avoids the issue entirely.
# NOTE: keep inline comments OFF empty-valued keys below — docker compose's
# env-file parser reads "KEY=   # text" as the literal value "# text", which
# would set a garbage DASHSCOPE_BASE_URL. Comments for empty keys go on their
# own line.
# DashScope key (or a DO model-access key if routing through DO):
DASHSCOPE_API_KEY=
# Leave empty for DashScope intl; set to https://inference.do-ai.run/v1 for DO:
DASHSCOPE_BASE_URL=
BARAZA_AI_MODEL=qwen-plus                 # domain agents + Q&A bot (tool-calling)
# OPTIONAL: faster/smaller Qwen for the Q&A bot only (falls back to BARAZA_AI_MODEL). Keep it a Qwen model.
BARAZA_BOT_MODEL=
BARAZA_ANALYST_MODEL=qwen-max             # premise/impl analysts + JSON extraction
DELIBERATION_AI_MODEL=qwen-plus           # deliberation digest

# Real web search for the Shahidi fact-checker (Tavily — https://tavily.com, free tier).
# Empty = Shahidi degrades to reasoning from context (no live search). DashScope's
# enable_search is silently ignored on the intl endpoint, so we use a search tool.
TAVILY_API_KEY=

# ── Hackathon judges' demo login (POST /auth/demo-login + /judges) ───────────
# Shared passcode → a pre-seeded demo account (no signup). Empty = disabled;
# must be ≥8 chars to enable. Provision the account with the demo seed:
#   docker exec ujamaa_web node dist/core/database/seed-demo.js
DEMO_ACCESS_CODE=                          # e.g. a long random phrase; share with judges
DEMO_JUDGE_EMAIL=demo@ujamaadao.org        # the pre-seeded demo account email

# ── Blockchain (Base) — dormant until contracts deployed ─────────────────────
BASE_RPC_URL=
MINTER_PRIVATE_KEY=
PR_TOKEN_ADDRESS=
UT_TOKEN_ADDRESS=
GOVERNANCE_VOTING_ADDRESS=

# ── Integrations ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
FOUNDER_EMAILS=                          # comma-separated; auto-verified at seed
DD_API_KEY=                              # Datadog (optional)

# ── Frontend build-time (also set as GitHub Actions Variables/Secrets) ───────
# These are baked into the client bundle by CI, not read at runtime — keep them
# in sync with the repo's Actions Variables/Secrets.
NEXT_PUBLIC_API_URL=https://api.ujamaadao.org/api/v1
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Container images (optional — default to ghcr.io …:latest in compose) ─────
# Set to a sha-XXXX tag to pin/rollback a specific CI build.
# FRONTEND_IMAGE=ghcr.io/waicharikim/ujamaa-frontend:latest
# WEB_IMAGE=ghcr.io/waicharikim/ujamaa-web:latest
# WORKER_IMAGE=ghcr.io/waicharikim/ujamaa-worker:latest
