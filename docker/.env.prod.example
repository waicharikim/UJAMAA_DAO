# ─────────────────────────────────────────────────────────────────────────────
# UjamaaDAO — PRODUCTION env template
#
# Copy to `docker/.env.prod` on the droplet and fill in real values. The real
# file is gitignored (.env.* is ignored; only *.example is committed) — NEVER
# commit it. The Makefile/aliases load it via `--env-file ../docker/.env.prod`.
#
# Fastest way to populate on the droplet (it already holds all secrets):
#   cp docker/.env docker/.env.prod
# then adjust anything prod-specific below.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core / Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ujamaa_user:CHANGE_ME@postgres:5432/ujamaa_db
POSTGRES_USER=ujamaa_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ujamaa_db

# ── DB backups (docker/backup-db.sh — install: `make prod-backup-cron`) ──────
# Local rolling window lives in $HOME/ujamaa-backups. Set BACKUP_RCLONE_REMOTE to
# an rclone remote (e.g. a DigitalOcean Space) for the OFF-BOX copy that actually
# protects against droplet loss — leave empty and backups are on-box only.
BACKUP_RETENTION_DAYS=14
BACKUP_RCLONE_REMOTE=

BASE_URL=https://api.ujamaadao.org
FRONTEND_URL=https://ujamaadao.org
ALLOWED_ORIGINS=https://ujamaadao.org

# ── Auth / Crypto ────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_min_32_chars
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars   # openssl rand -hex 32

# ── Email (SMTP / Resend) ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ujamaadao.org
RESEND_API_KEY=

# ── SMS (Africa's Talking) ───────────────────────────────────────────────────
ENABLE_SMS=false
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ── M-Pesa (Buni by KCB) ─────────────────────────────────────────────────────
BUNI_BASE_URL=
BUNI_CLIENT_ID=
BUNI_CLIENT_SECRET=
BUNI_B2C_SHORTCODE=
BUNI_B2C_INITIATOR_NAME=
BUNI_B2C_SECURITY_CREDENTIAL=

# ── AI (Baraza bot / deliberation) ───────────────────────────────────────────
# OpenAI-compatible inference. Leave DASHSCOPE_API_KEY empty to disable the AI
# layer entirely (it null-guards → dormant). Provider is switched by URL/key/
# model only — no code change:
#   • DigitalOcean serverless inference: DASHSCOPE_BASE_URL=https://inference.do-ai.run/v1
#     models e.g. alibaba-qwen3-32b, anthropic-claude-5-sonnet
#   • Alibaba DashScope (hackathon): leave DASHSCOPE_BASE_URL empty (intl default);
#     models qwen-plus / qwen-max
DASHSCOPE_API_KEY=                        # model access key (DO) or DashScope key
DASHSCOPE_BASE_URL=                       # DO: https://inference.do-ai.run/v1 ; DashScope: empty
BARAZA_AI_MODEL=alibaba-qwen3-32b         # domain agents + Q&A bot (tool-calling)
BARAZA_ANALYST_MODEL=alibaba-qwen3-32b    # premise/impl analysts + JSON extraction (Claude = quality bump)
DELIBERATION_AI_MODEL=alibaba-qwen3-32b   # deliberation digest

# ── Blockchain (Base) — dormant until contracts deployed ─────────────────────
BASE_RPC_URL=
MINTER_PRIVATE_KEY=
PR_TOKEN_ADDRESS=
UT_TOKEN_ADDRESS=
GOVERNANCE_VOTING_ADDRESS=

# ── Integrations ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
FOUNDER_EMAILS=                          # comma-separated; auto-verified at seed
DD_API_KEY=                              # Datadog (optional)

# ── Frontend build-time (also set as GitHub Actions Variables/Secrets) ───────
# These are baked into the client bundle by CI, not read at runtime — keep them
# in sync with the repo's Actions Variables/Secrets.
NEXT_PUBLIC_API_URL=https://api.ujamaadao.org/api/v1
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Container images (optional — default to ghcr.io …:latest in compose) ─────
# Set to a sha-XXXX tag to pin/rollback a specific CI build.
# FRONTEND_IMAGE=ghcr.io/waicharikim/ujamaa-frontend:latest
# WEB_IMAGE=ghcr.io/waicharikim/ujamaa-web:latest
# WORKER_IMAGE=ghcr.io/waicharikim/ujamaa-worker:latest
