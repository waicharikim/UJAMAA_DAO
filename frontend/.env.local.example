# UjamaaDAO Frontend — Local Development Environment
# Copy to .env.local — do NOT commit .env.local
#
# Usage: cp .env.local.example .env.local

# Backend API base URL (no trailing slash)
# Must be reachable from the browser (host), not via Docker internal network
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Privy wallet integration — https://dashboard.privy.io
# This is an App ID (not a secret) — safe to store here
# Development App ID — use your own for production
NEXT_PUBLIC_PRIVY_APP_ID=cmm3oautu048e0djonwhybq5c
