# Keep the Docker build context lean. These never belong in the image build —
# node_modules is reinstalled by the `deps` stage and dist is regenerated by the
# `builder` stage. NOTE: this only affects `docker build`; local dev (host
# `npm run dev` or the bind-mounted dev containers) is unaffected.
node_modules
dist

# VCS / editor / tooling
.git
.gitignore
.dockerignore
.vscode

# Env + secrets (backend takes all config as runtime env, none at build time)
.env
.env.*

# Test / coverage artifacts
coverage
.nyc_output

# Logs / OS cruft
npm-debug.log
*.log
.DS_Store
