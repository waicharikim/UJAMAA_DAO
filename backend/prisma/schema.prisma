generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// -------- ENUMS --------

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  MFA_CHALLENGE
}

enum GroupType {
  // **LOCATION-BASED** (Primary)
  WARD_COMMUNITY // Ward clean-up, youth groups
  CONSTITUENCY_PROJECT // Constituency development
  COUNTY_INITIATIVE // County-wide programs
  NATIONAL_CAMPAIGN // National movements

  // **SECTOR-BASED** (Secondary)
  BUSINESS // Companies/SMEs
  NON_PROFIT // NGOs, CBOs
  EDUCATION // Schools, universities
  RELIGIOUS // Churches, mosques
  HEALTH // Clinics, hospitals
  AGRICULTURE // Farmers co-ops
  YOUTH // Youth groups
  WOMEN // Women's groups

  // **PROJECT-BASED** (Temporary)
  PROJECT_GROUP // Time-bound projects

  // **NEW: EXPERT & ADVISORY**
  TECHNICAL_ADVISORY
  QUALITY_ASSURANCE
  PROFESSIONAL_NETWORK
  EXPERT_PANEL

  // **NEW: SPECIALIZED FUNCTIONAL**
  EMERGENCY_RESPONSE
  DISASTER_MANAGEMENT
  ENVIRONMENTAL
  CULTURAL
  INFRASTRUCTURE
  SAVINGS_CREDIT
  SELF_HELP
}

enum GroupRole {
  MEMBER
  LEADER
  TREASURER
  AUDITOR
  FACILITATOR
  MENTOR
}

enum ParticipantRole {
  MEMBER
  ADMIN
  MILESTONE_VERIFIER
  QUALITY_CONTROLLER
}

enum ProposalType {
  COMMUNITY_INITIATIVE
  MAJOR_PROJECT
  STRATEGIC_DECISION
  EMERGENCY
}

enum ProposalStatus {
  DRAFT
  VOTING
  APPROVED
  REJECTED
  EXECUTING
  COMPLETED
}

enum LocationScope {
  WARD
  CONSTITUENCY
  COUNTY
  NATIONAL
}

enum HolderType {
  USER
  GROUP
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum GroupStatus {
  FORMING
  ACTIVE
  SUSPENDED
  INACTIVE
  DISSOLVED
  MERGED
}

enum SystemRole {
  super_admin
  auditor
  compliance_officer
  support_staff
  general_user
  governor_admin
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  SPEND
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImpactPointType {
  LOCATION_BASED // Ward/Constituency tasks
  SYSTEM // National/global tasks
}

enum IPTier {
  TIER_1 // 0-100 IP
  TIER_2 // 101-500 IP  
  TIER_3 // 501+ IP
}

enum WorkType {
  MANUAL_LABOR
  SKILLED_WORK
  COMMUNITY_SERVICE
  SUPERVISION
  TRAINING
}

enum WorkVerificationStatus {
  PENDING
  VERIFIED
  DISPUTED
  REJECTED
}

enum WorkVerificationMethod {
  PEER
  SUPERVISOR
  COMMUNITY_WITNESS
  DIGITAL_EVIDENCE
}

enum EducationalContentLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CERTIFIED
}

enum EmergencyType {
  NATURAL_DISASTER
  HEALTH_CRISIS
  CONFLICT
  INFRASTRUCTURE_FAILURE
  ENVIRONMENTAL
}

enum EmergencySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// -------- MODELS --------

model User {
  id            String  @id @default(uuid()) @db.Uuid
  walletAddress String  @unique
  email         String  @unique
  passwordHash  String?
  name          String
  phoneNumber   String  @unique

  // UPDATED: Geographic affiliations - now with primary/secondary wards
  primaryWardId   String  @db.Uuid
  primaryWard     Ward    @relation("UserPrimaryWard", fields: [primaryWardId], references: [id])
  secondaryWardId String? @db.Uuid
  secondaryWard   Ward?   @relation("UserSecondaryWard", fields: [secondaryWardId], references: [id])

  avatarUrl         String?
  industryId        String? @db.Uuid
  nonce             String
  emailVerified     Boolean @default(false)
  phoneVerified     Boolean @default(false)
  communityVerified Boolean @default(false)
  locationVerified  Boolean @default(false)

  isActive     Boolean @default(true)
  tokenVersion Int     @default(0)

  // UPDATED: Three-tier economic system
  globalImpactPoints  Int      @default(0) // Tier 1: Visible IP
  utilityTokens       Int      @default(0) // Tier 2: Visible UT
  participationRights Int      @default(10) // Tier 3: Hidden PR (monthly allowance)
  lastPRReset         DateTime @default(now())

  // NEW: Group limits enforcement
  groupsCreatedCount Int @default(0)

  // REMOVED: voteWeight (now calculated dynamically from IP)
  // REMOVED: duesDestination, affiliations (handled by primaryWard)

  mfaEnabled  Boolean   @default(false)
  mfaSecret   String?
  lastLoginAt DateTime?
  metadata    Json?

  authTokens    AuthToken[]
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // UPDATED RELATIONS
  userRoles               UserRole[]
  walletBalances          WalletBalance[]          @relation("UserWalletBalances")
  groups                  GroupMember[]
  industry                Industry?                @relation(fields: [industryId], references: [id])
  goodsServices           GoodsService[]           @relation("UserGoodsServices")
  notificationPreferences NotificationPreference[] @relation("UserNotificationPreferences")
  proposals               Proposal[]               @relation("UserProposals")

  // UPDATED: Location-bound IP system
  locationImpacts UserLocationImpact[]

  tokenBalances       TokenBalance[]       @relation("UserTokenBalances")
  projectParticipants ProjectParticipant[] @relation("UserProjectParticipants")
  groupMemberVotes    GroupMemberVote[]    @relation("GroupMemberVote_User")
  activityLogs        UserActivityLog[]    @relation("UserActivities")
  privacySettings     UserPrivacySettings? @relation("UserPrivacy")
  audits              UserAudit[]          @relation("UserAudits")
  userConsents        UserConsent[]        @relation("UserConsents")
  verificationTokens  VerificationToken[]
  // NEW: Physical work tracking
  physicalWorkLogs       PhysicalWorkLog[]
  workVerificationsGiven WorkVerification[]

  // NEW: Educational progress
  educationalProgress UserEducationalProgress[]

  // NEW: Emergency response
  emergencyResponses EmergencyResponse[]

  // NEW: Accessibility
  accessibilityProfile UserAccessibility? @relation("UserAccessibility_Owner")

  // MISSING: Work reputation metrics
  totalHoursWorked     Decimal @default(0) @db.Decimal(10, 2)
  averageQualityRating Decimal @default(0) @db.Decimal(3, 2)
  workReliabilityScore Int     @default(100) // 0-100 scale

  // MISSING: Expert status
  isExpert       Boolean  @default(false)
  expertVerified Boolean  @default(false)
  expertAreas    String[] // Areas of expertise
  expertTier     String? // LOCAL, REGIONAL, NATIONAL

  // MISSING: Financial risk metrics
  financialHealthScore Int? // 0-100 scale
  riskAssessment       Json?

  // MISSING: Youth status for development programs
  birthDate DateTime?
  isYouth   Boolean?  @default(false) // Calculated field: 16-35 years

  // ✅ Conflict resolution relations (ONCE)
  conflictCasesAsComplainant ConflictCase[] @relation("Complainant")
  conflictCasesAsRespondent  ConflictCase[] @relation("Respondent")

  // ✅ Marketplace relations (ONCE)
  marketplaceListingsAsSeller MarketplaceListing[]     @relation("MarketplaceListing_SellerUser")
  marketplaceTransactions     MarketplaceTransaction[] @relation("MarketplaceTransaction_Buyer")
  marketplaceReviews          MarketplaceReview[]      @relation("MarketplaceReview_Reviewer")

  // ✅ Community asset relations (ONCE)
  ownedCommunityAssets CommunityAsset[] @relation("CommunityAsset_OwnerUser")
  assetBookings        AssetBooking[]   @relation("AssetBooking_User")

  // ✅ Platform feedback relations (ONCE)
  platformFeedback    PlatformFeedback[]    @relation("PlatformFeedback_User")
  feedbackComments    FeedbackComment[]     @relation("FeedbackComment_User")
  EducationalModule   EducationalModule[]
  EducationalReview   EducationalReview[]
  EmergencyAlert      EmergencyAlert[]
  UserAccessibility   UserAccessibility[]
  SystemConfiguration SystemConfiguration[]

  @@unique([primaryWardId, secondaryWardId])
}

// NEW: Location-bound IP tracking
model UserLocationImpact {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  wardId       String   @db.Uuid
  ward         Ward     @relation(fields: [wardId], references: [id])
  points       Int      @default(0)
  tier         IPTier   @default(TIER_1)
  lastActivity DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, wardId])
  @@index([wardId, points])
  @@index([userId, lastActivity])
}

// NEW: Ward model for geographic hierarchy
model Ward {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  code           String?      @unique
  constituency   Constituency @relation(fields: [constituencyId], references: [id])
  constituencyId String       @db.Uuid

  // Relations
  primaryUsers    User[]               @relation("UserPrimaryWard")
  secondaryUsers  User[]               @relation("UserSecondaryWard")
  locationImpacts UserLocationImpact[]
  groups          Group[]

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  County             County?              @relation(fields: [countyId], references: [id])
  countyId           String?              @db.Uuid
  MarketplaceListing MarketplaceListing[]
  CommunityAsset     CommunityAsset[]
  CommunityDashboard CommunityDashboard[]
}

model Group {
  id            String  @id @default(uuid()) @db.Uuid
  name          String  @unique
  description   String?
  metadata      Json?
  walletAddress String  @unique

  // UPDATED: Geographic scope with explicit ward relationship
  locationScope  LocationScope
  wardId         String?       @db.Uuid
  constituencyId String?       @db.Uuid
  countyId       String?       @db.Uuid

  ward         Ward?         @relation(fields: [wardId], references: [id])
  constituency Constituency? @relation(fields: [constituencyId], references: [id])
  county       County?       @relation(fields: [countyId], references: [id])

  industryFocusId String?   @db.Uuid
  industryFocus   Industry? @relation(fields: [industryFocusId], references: [id])

  productsServices GoodsService[] @relation("GroupGoodsServices")

  // UPDATED: Enhanced group status
  status          GroupStatus @default(FORMING)
  memberCount     Int         @default(0)
  treasuryBalance Decimal     @default(0) @db.Decimal(20, 2)
  lastActivity    DateTime    @default(now())

  groupType GroupType @default(WARD_COMMUNITY)

  walletBalances WalletBalance[] @relation("GroupWalletBalances")

  members       GroupMember[]
  proposals     Proposal[]     @relation("GroupProposals")
  tokenBalances TokenBalance[] @relation("GroupTokenBalances")

  // MISSING: Financial controls
  multiSigThresholds Json? // {small: 1, medium: 2, large: 3}
  spendingLimits     Json? // {daily: 50000, weekly: 200000, monthly: 500000}

  // MISSING: Group constitution
  constitution     Json? // Group governance rules
  amendmentProcess Json? // How constitution can be changed

  // MISSING: Performance metrics
  successRate        Decimal @default(0) @db.Decimal(3, 2)
  memberSatisfaction Decimal @default(0) @db.Decimal(3, 2)

  groupMemberVotes GroupMemberVote[] @relation("GroupMemberVote_Group")

  // NEW: Group financial controls
  dissolutionWarningSent Boolean   @default(false)
  dissolutionDate        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ COMPLETE Relations with proper naming
  emergencyAlerts EmergencyAlert[]

  // Marketplace relations for groups as sellers
  marketplaceListingsAsSeller MarketplaceListing[] @relation("MarketplaceListing_SellerGroup")

  // Community asset relations for groups as owners  
  communityAssets   CommunityAsset[]    @relation("CommunityAsset_OwnerGroup")
  EducationalModule EducationalModule[]
}

model VerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // 'EMAIL_VERIFICATION', 'PHONE_VERIFICATION', etc.
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([token])
  @@index([expiresAt])
}


model GroupMember {
  id       String    @id @default(uuid()) @db.Uuid
  user     User      @relation(fields: [userId], references: [id])
  userId   String    @db.Uuid
  group    Group     @relation(fields: [groupId], references: [id])
  groupId  String    @db.Uuid
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  active   Boolean   @default(true)

  @@unique([userId, groupId])
  @@index([groupId, role])
  @@index([userId])
}

model WalletBalance {
  id         String     @id @default(uuid()) @db.Uuid
  holderType HolderType
  userId     String?    @db.Uuid
  groupId    String?    @db.Uuid
  balance    Decimal    @db.Decimal(20, 2)
  currency   String     @default("KES")
  updatedAt  DateTime   @updatedAt

  user  User?  @relation("UserWalletBalances", fields: [userId], references: [id])
  group Group? @relation("GroupWalletBalances", fields: [groupId], references: [id])

  WalletTransactions WalletTransaction[]

  @@unique([holderType, userId], name: "holderType_userId_wallet")
  @@unique([holderType, groupId], name: "holderType_groupId_wallet")
}

model WalletTransaction {
  id              String            @id @default(uuid()) @db.Uuid
  walletBalanceId String            @db.Uuid
  type            TransactionType // e.g., "deposit", "withdrawal", "spend", "refund"
  amount          Decimal           @db.Decimal(20, 2)
  mpesaReceipt    String? // optional
  description     String? // optional notes
  status          TransactionStatus // e.g., "pending", "completed", "failed"
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  walletBalance WalletBalance @relation(fields: [walletBalanceId], references: [id])

  @@index([walletBalanceId])
  @@index([mpesaReceipt])
}

model Project {
  id            String        @id @default(uuid()) @db.Uuid
  proposalId    String        @unique @db.Uuid
  title         String
  description   String
  metadata      Json?
  budget        Int?
  timeline      String?
  status        ProjectStatus @default(ACTIVE)
  locationScope LocationScope
  wardId        String?       @db.Uuid
  constituency  String?
  county        String?

  // NEW: Project classification
  projectType String? // INFRASTRUCTURE, ECONOMIC_DEVELOPMENT, SOCIAL_SERVICE, ENVIRONMENTAL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposal     Proposal             @relation("ProposalToProject", fields: [proposalId], references: [id])
  participants ProjectParticipant[]
  milestones   ProjectMilestone[]

  // NEW: Physical work tracking for projects
  physicalWorkLogs PhysicalWorkLog[]

  // NEW: Educational components
  educationalModules EducationalModule[]

  // MISSING: Enhanced classification
  projectComplexity   String @default("SIMPLE") // SIMPLE, MODERATE, COMPLEX
  riskLevel           String @default("LOW") // LOW, MEDIUM, HIGH
  environmentalImpact Json? // Environmental impact assessment

  // MISSING: Expert requirements
  requiredExpertise String[] // Types of experts needed
  assignedExperts   String[] @db.Uuid // User IDs of assigned experts

  // MISSING: Learning and replication
  isTemplate       Boolean @default(false)
  templateFor      String? // Project type this can template for
  replicationGuide Json? // Guide for replicating this project
}

// NEW: Physical Work Verification System
model PhysicalWorkLog {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id])
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id])

  // Work details
  workDate    DateTime
  hours       Decimal  @db.Decimal(4, 2)
  workType    WorkType
  description String
  location    String?

  // Verification status
  status     WorkVerificationStatus @default(PENDING)
  verifiedBy String?                @db.Uuid
  verifiedAt DateTime?

  // Evidence
  photoUrls  String[]
  witnessIds String[] @db.Uuid

  // Quality assessment
  qualityRating Int?
  notes         String?

  // IP calculation
  baseIP            Int
  qualityMultiplier Decimal @default(1.0) @db.Decimal(3, 2)
  totalIPEarned     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Verification relations
  verifications WorkVerification[]

  @@index([projectId, workDate])
  @@index([userId, status])
  @@index([workType, status])
}

model WorkVerification {
  id         String          @id @default(uuid()) @db.Uuid
  workLogId  String          @db.Uuid
  workLog    PhysicalWorkLog @relation(fields: [workLogId], references: [id])
  verifierId String          @db.Uuid
  verifier   User            @relation(fields: [verifierId], references: [id])

  method   WorkVerificationMethod
  status   WorkVerificationStatus
  comments String?
  evidence String[]

  createdAt DateTime @default(now())

  @@unique([workLogId, verifierId])
  @@index([verifierId, createdAt])
}

// NEW: Educational Content System
model EducationalModule {
  id          String                  @id @default(uuid()) @db.Uuid
  title       String
  description String
  content     String
  mediaUrls   String[]
  duration    Int
  difficulty  EducationalContentLevel
  category    String

  // Ownership
  creatorId String  @db.Uuid
  creator   User    @relation(fields: [creatorId], references: [id])
  groupId   String? @db.Uuid
  group     Group?  @relation(fields: [groupId], references: [id])

  // Verification
  verified       Boolean @default(false)
  expertApproved Boolean @default(false)

  // IP rewards
  completionIP Int @default(0)

  // Tracking
  views         Int     @default(0)
  averageRating Decimal @default(0) @db.Decimal(3, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  progress    UserEducationalProgress[]
  assessments EducationalAssessment[]
  reviews     EducationalReview[]

  // Project integration
  projects Project[]
}

model UserEducationalProgress {
  id       String            @id @default(uuid()) @db.Uuid
  userId   String            @db.Uuid
  user     User              @relation(fields: [userId], references: [id])
  moduleId String            @db.Uuid
  module   EducationalModule @relation(fields: [moduleId], references: [id])

  status      ProgressStatus @default(IN_PROGRESS)
  progress    Int            @default(0)
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  score       Int?

  @@unique([userId, moduleId])
}

model EducationalAssessment {
  id       String            @id @default(uuid()) @db.Uuid
  moduleId String            @db.Uuid
  module   EducationalModule @relation(fields: [moduleId], references: [id])

  questions    Json
  passingScore Int  @default(70)
  maxAttempts  Int  @default(3)

  createdAt DateTime @default(now())
}

model EducationalReview {
  id       String            @id @default(uuid()) @db.Uuid
  moduleId String            @db.Uuid
  module   EducationalModule @relation(fields: [moduleId], references: [id])
  userId   String            @db.Uuid
  user     User              @relation(fields: [userId], references: [id])

  rating  Int
  comment String?
  helpful Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([userId, moduleId])
}

// NEW: Emergency Response System
model EmergencyAlert {
  id            String            @id @default(uuid()) @db.Uuid
  title         String
  description   String
  emergencyType EmergencyType
  severity      EmergencySeverity
  location      String
  reporterId    String            @db.Uuid
  reporter      User              @relation(fields: [reporterId], references: [id])

  // Response coordination
  status          String  @default("ACTIVE")
  assignedGroupId String? @db.Uuid
  assignedGroup   Group?  @relation(fields: [assignedGroupId], references: [id])

  // Resources
  neededResources    Json
  availableResources Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses EmergencyResponse[]
}

model EmergencyResponse {
  id          String         @id @default(uuid()) @db.Uuid
  emergencyId String         @db.Uuid
  emergency   EmergencyAlert @relation(fields: [emergencyId], references: [id])
  userId      String         @db.Uuid
  user        User           @relation(fields: [userId], references: [id])

  role     String
  status   String   @default("AVAILABLE")
  skills   String[]
  location String?
  notes    String?

  @@unique([emergencyId, userId])
}

// NEW: Accessibility System
model UserAccessibility {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation("UserAccessibility_Owner", fields: [userId], references: [id])

  // Accessibility needs
  literacyLevel     String  @default("LITERATE")
  visualImpairment  Boolean @default(false)
  hearingImpairment Boolean @default(false)
  motorImpairment   Boolean @default(false)
  preferredLanguage String  @default("sw")

  // Interface adaptations
  interfaceSize  String  @default("NORMAL")
  audioInterface Boolean @default(false)
  simpleMode     Boolean @default(false)

  // Support network
  helperUserId String? @db.Uuid
  helper       User?   @relation(fields: [helperUserId], references: [id])

  @@unique([userId])
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  user       User      @relation(fields: [userId], references: [id])
  userId     String    @db.Uuid
  tokenHash  String
  expiresAt  DateTime?
  revoked    Boolean   @default(false)
  revokedAt  DateTime?
  replacedBy Int?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  ip         String?
  userAgent  String?
  deviceName String?
  metadata   Json?

  @@index([userId])
  @@index([tokenHash])
  @@index([revoked])
  @@index([expiresAt])
}

model AuthToken {
  id        String        @id @default(uuid())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String        @db.Uuid
  tokenHash String
  type      AuthTokenType // 'verify_email' | 'reset_password'
  expiresAt DateTime
  used      Boolean       @default(false)
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  ip        String?
  userAgent String
  metadata  Json?

  @@index([userId])
  @@index([tokenHash])
  @@index([type])
}

model ProjectParticipant {
  id          String          @id @default(uuid()) @db.Uuid
  project     Project         @relation(fields: [projectId], references: [id])
  projectId   String          @db.Uuid
  participant User            @relation(fields: [userId], references: [id], name: "UserProjectParticipants")
  userId      String          @db.Uuid
  role        ParticipantRole @default(MEMBER)
  joinedAt    DateTime        @default(now())

  @@unique([projectId, userId])
  @@index([projectId, role])
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique // e.g. 'system:super_admin' or 'custom:read_only'
  namespace String? // optional
  builtin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  UserRole        UserRole[]
  rolePermissions RolePermission[]
}

model UserRole {
  id         String    @id @default(uuid()) @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  userId     String    @db.Uuid
  roleId     Int
  role       Role      @relation(fields: [roleId], references: [id])
  scope      String?
  active     Boolean   @default(true)
  assignedBy String?   @db.Uuid // user id who assigned this role (optional)
  assignedAt DateTime  @default(now())
  expiresAt  DateTime? // optional expiry for time-bound assignments
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, roleId, scope])
  @@index([roleId, scope])
  @@index([userId])
  @@index([active])
}

model RolePermission {
  id          String   @id @default(uuid()) @db.Uuid
  roleId      Int
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission  String // e.g., 'projects:read', 'users:manage'
  description String?
  createdAt   DateTime @default(now())

  @@unique([roleId, permission])
  @@index([permission])
}

model Industry {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @unique
  users  User[]
  groups Group[]
}

model GoodsService {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @unique
  users  User[]  @relation("UserGoodsServices")
  groups Group[] @relation("GroupGoodsServices")
}

model County {
  id             String         @id @default(uuid()) @db.Uuid
  code           String         @unique
  name           String         @unique
  constituencies Constituency[]
  wards          Ward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Group     Group[]
}

model Constituency {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  county   County @relation(fields: [countyId], references: [id])
  countyId String @db.Uuid
  wards    Ward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Group     Group[]

  @@unique([name, countyId])
}

model Proposal {
  id           String       @id @default(uuid()) @db.Uuid
  title        String
  description  String
  proposalType ProposalType @default(COMMUNITY_INITIATIVE)

  // UPDATED: Voting tier classification
  votingTier String @default("COMMUNITY_INITIATIVE") // COMMUNITY_INITIATIVE, MAJOR_PROJECT, STRATEGIC_DECISION

  funded         Boolean        @default(false)
  budget         Int?
  timeline       String?
  locationScope  LocationScope
  wardId         String?        @db.Uuid
  constituency   String?
  county         String?
  isPrivate      Boolean        @default(false)
  purposeDetails Json?
  status         ProposalStatus @default(DRAFT)

  creatorUserId  String? @db.Uuid
  creatorGroupId String? @db.Uuid

  creatorUser  User?  @relation("UserProposals", fields: [creatorUserId], references: [id])
  creatorGroup Group? @relation("GroupProposals", fields: [creatorGroupId], references: [id])

  project Project? @relation("ProposalToProject")

  votes Vote[]

  groupMemberVotes GroupMemberVote[] @relation("GroupMemberVote_Proposal")

  // MISSING: Voting thresholds (calculated fields)
  requiredQuorum   Decimal @db.Decimal(3, 2) // 0.4, 0.5, 0.6
  requiredApproval Decimal @db.Decimal(3, 2) // 0.5, 0.6, 0.66

  // MISSING: Internal approval for group proposals
  internalApproved  Boolean @default(false)
  internalVoteCount Json? // {for: 15, against: 3, abstain: 2}

  // MISSING: Emergency classification
  isEmergency            Boolean @default(false)
  emergencyJustification String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vote {
  id          String   @id @default(uuid()) @db.Uuid
  proposalId  String   @db.Uuid
  voterId     String   @db.Uuid
  isGroup     Boolean
  vote        Boolean
  tokensSpent Int
  createdAt   DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id])

  @@index([proposalId])
}

model GroupMemberVote {
  id         String   @id @default(uuid()) @db.Uuid
  proposalId String   @db.Uuid
  groupId    String   @db.Uuid
  userId     String   @db.Uuid
  vote       Boolean
  createdAt  DateTime @default(now())

  proposal Proposal @relation("GroupMemberVote_Proposal", fields: [proposalId], references: [id])
  group    Group    @relation("GroupMemberVote_Group", fields: [groupId], references: [id])
  user     User     @relation("GroupMemberVote_User", fields: [userId], references: [id])

  @@unique([proposalId, groupId, userId])
}

model TokenBalance {
  id         String     @id @default(uuid())
  holderType HolderType
  userId     String?    @db.Uuid
  groupId    String?    @db.Uuid
  balance    Int        @default(0)
  updatedAt  DateTime   @updatedAt

  user  User?  @relation("UserTokenBalances", fields: [userId], references: [id])
  group Group? @relation("GroupTokenBalances", fields: [groupId], references: [id])

  @@unique([holderType, userId], name: "holderType_userId")
  @@unique([holderType, groupId], name: "holderType_groupId")
}

model ProjectMilestone {
  id            String          @id @default(uuid()) @db.Uuid
  project       Project         @relation(fields: [projectId], references: [id])
  projectId     String          @db.Uuid
  title         String
  description   String
  dueDate       DateTime?
  status        MilestoneStatus @default(PENDING)
  fundingAmount Int
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model UserPrivacySettings {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation("UserPrivacy", fields: [userId], references: [id])
  settings  Json
  updatedAt DateTime @updatedAt
}

model UserAudit {
  id        String   @id @default(uuid()) @db.Uuid
  user      User     @relation("UserAudits", fields: [userId], references: [id])
  userId    String   @db.Uuid
  field     String // Field changed or accessed (e.g. "email")
  oldValue  String? // Old value JSON serialized
  newValue  String? // New value JSON serialized
  changedBy String? // UserId of the user who made the change (nullable if self)
  timestamp DateTime @default(now())
}

model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String   @db.Uuid
  user      User     @relation("UserNotificationPreferences", fields: [userId], references: [id])
  channel   String // e.g., "email", "sms", "in-app"
  eventType String // e.g., "email_verification", "proposal_update"
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, channel, eventType])
}

model UserActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], name: "UserActivities")
  eventType String
  eventData Json? // Optional JSON for additional metadata
  ipAddress String? // User IP address
  userAgent String? // User agent string from request header
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model UserConsent {
  id          String   @id @default(uuid())
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], name: "UserConsents")
  policyType  String // e.g., "terms_of_service", "privacy_policy"
  version     String // Version of policy agreed to
  consentedAt DateTime // Timestamp of consent
  ipAddress   String? // Optional: IP address when consent was given
  userAgent   String? // Optional: User agent info
}

// MISSING: Conflict resolution models
model ConflictCase {
  id          String @id @default(uuid()) @db.Uuid
  title       String
  description String
  caseType    String // FINANCIAL, PROJECT, GOVERNANCE, INTERPERSONAL

  // Parties involved
  complainantId String @db.Uuid
  complainant   User   @relation("Complainant", fields: [complainantId], references: [id])
  respondentId  String @db.Uuid
  respondent    User   @relation("Respondent", fields: [respondentId], references: [id])

  // Case details
  severity String // LOW, MEDIUM, HIGH, CRITICAL
  status   String @default("DIRECT_MEDIATION") // DIRECT_MEDIATION, COMMUNITY_PANEL, EXPERT_ARBITRATION, SUPREME_COURT
  evidence Json // Submitted evidence

  // Resolution tracking
  currentLevel Int       @default(1)
  resolution   String?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  mediationSessions MediationSession[]
  rulings           ConflictRuling[]
}

model MediationSession {
  id         String       @id @default(uuid()) @db.Uuid
  conflictId String       @db.Uuid
  conflict   ConflictCase @relation(fields: [conflictId], references: [id])

  // Session details
  level       Int       @default(1)
  mediators   String[]  @db.Uuid // User IDs of mediators
  scheduledAt DateTime
  completedAt DateTime?
  outcome     String?

  // Session notes
  notes      String?
  agreements Json?

  createdAt DateTime @default(now())
}

model ConflictRuling {
  id         String       @id @default(uuid()) @db.Uuid
  conflictId String       @db.Uuid
  conflict   ConflictCase @relation(fields: [conflictId], references: [id])

  // Ruling details
  rulingBody String // "COMMUNITY_PANEL", "EXPERT_ARBITRATION", "SUPREME_COURT"
  rulingText String
  binding    Boolean @default(false)

  // Enforcement
  enforcementActions Json
  complianceDeadline DateTime?

  // FIX: Added the ruling authority ID and relation
  ruledBy String @db.Uuid
  ruler   User   @relation("ConflictRuling_Ruler", fields: [ruledBy], references: [id])

  createdAt DateTime @default(now())
}

// MISSING: Enhanced marketplace models
model MarketplaceListing {
  id          String  @id @default(uuid()) @db.Uuid
  title       String
  description String
  price       Decimal @db.Decimal(20, 2)
  quantity    Int     @default(1)

  // Listing type and scope
  listingType String // GOODS, SERVICE, PROCUREMENT
  marketTier  String  @default("LOCAL") // LOCAL, REGIONAL, NATIONAL
  wardId      String? @db.Uuid
  ward        Ward?   @relation(fields: [wardId], references: [id])

  // Seller information
  sellerType    HolderType
  sellerUserId  String?    @db.Uuid
  sellerUser    User?      @relation("MarketplaceListing_SellerUser", fields: [sellerUserId], references: [id])
  sellerGroupId String?    @db.Uuid
  sellerGroup   Group?     @relation("MarketplaceListing_SellerGroup", fields: [sellerGroupId], references: [id])

  // Status and verification
  status        String  @default("ACTIVE")
  verified      Boolean @default(false)
  qualityRating Decimal @default(0) @db.Decimal(3, 2)

  // Transaction tracking
  views      Int @default(0)
  salesCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transactions MarketplaceTransaction[]
  reviews      MarketplaceReview[]
}

model MarketplaceTransaction {
  id        String             @id @default(uuid()) @db.Uuid
  listingId String             @db.Uuid
  listing   MarketplaceListing @relation(fields: [listingId], references: [id])

  // Parties
  buyerId    String     @db.Uuid
  buyer      User       @relation("MarketplaceTransaction_Buyer", fields: [buyerId], references: [id])
  sellerId   String     @db.Uuid // Could be user or group
  sellerType HolderType

  // Transaction details
  quantity      Int
  totalPrice    Decimal @db.Decimal(20, 2)
  status        String  @default("PENDING") // PENDING, CONFIRMED, COMPLETED, DISPUTED
  escrowRelease Boolean @default(false)

  // Delivery and completion
  deliveryDetails Json?
  completedAt     DateTime?

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  // FIX: Relationship renamed and cardinality corrected
  review            MarketplaceReview? 
}

model MarketplaceReview {
  id            String                 @id @default(uuid()) @db.Uuid
  transactionId String                 @unique @db.Uuid // Ensure one review per transaction
  transaction   MarketplaceTransaction @relation(fields: [transactionId], references: [id])

  reviewerId   String     @db.Uuid
  reviewer     User       @relation("MarketplaceReview_Reviewer", fields: [reviewerId], references: [id])
  reviewedId   String     @db.Uuid // ID of the entity reviewed (User or Group ID)
  reviewedType HolderType

  rating           Int // 1-5
  comment          String?
  verifiedPurchase Boolean @default(true)

  createdAt DateTime @default(now())

  // REMOVED: marketplaceListingId field and its relation

  @@index([reviewedId, reviewedType])
}

// MISSING: Community asset sharing
model CommunityAsset {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  description String
  assetType   String // TOOL, EQUIPMENT, VEHICLE, FACILITY

  // Ownership
  ownerType    HolderType
  ownerUserId  String?    @db.Uuid
  ownerUser    User?      @relation("CommunityAsset_OwnerUser", fields: [ownerUserId], references: [id])
  ownerGroupId String?    @db.Uuid
  ownerGroup   Group?     @relation("CommunityAsset_OwnerGroup", fields: [ownerGroupId], references: [id])

  // Location and availability
  wardId   String  @db.Uuid
  ward     Ward    @relation(fields: [wardId], references: [id])
  location String?
  status   String  @default("AVAILABLE") // AVAILABLE, IN_USE, MAINTENANCE

  // Usage economics
  rentalCostUT Int? // Cost per hour in UT
  depositUT    Int? // Security deposit

  // Maintenance tracking
  maintenanceSchedule Json
  lastMaintenance     DateTime?
  nextMaintenance     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bookings        AssetBooking[]
  maintenanceLogs AssetMaintenanceLog[]
}

model AssetBooking {
  id      String         @id @default(uuid()) @db.Uuid
  assetId String         @db.Uuid
  asset   CommunityAsset @relation(fields: [assetId], references: [id])
  userId  String         @db.Uuid
  user    User           @relation("AssetBooking_User", fields: [userId], references: [id])

  // Booking period
  startTime DateTime
  endTime   DateTime
  status    String   @default("CONFIRMED") // PENDING, CONFIRMED, ACTIVE, COMPLETED, CANCELLED

  // Payment and deposits
  totalCostUT     Int?
  depositPaid     Boolean @default(false)
  depositRefunded Boolean @default(false)

  // Usage tracking
  purpose         String?
  conditionBefore Json?
  conditionAfter  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssetMaintenanceLog {
  id      String         @id @default(uuid()) @db.Uuid
  assetId String         @db.Uuid
  asset   CommunityAsset @relation(fields: [assetId], references: [id])

  maintenanceType String // ROUTINE, REPAIR, INSPECTION, UPGRADE
  description     String
  costUT          Int?
  performedBy     String   @db.Uuid // User ID
  performedAt     DateTime @default(now())

  // Maintenance details
  notes              String?
  nextMaintenanceDue DateTime?

  createdAt DateTime @default(now())

  @@index([assetId, performedAt])
}

// MISSING: Platform feedback and analytics
model PlatformFeedback {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation("PlatformFeedback_User", fields: [userId], references: [id])

  category    String // BUG, FEATURE_REQUEST, UX_ISSUE, GENERAL
  title       String
  description String
  urgency     String @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL

  // Status tracking
  status     String  @default("SUBMITTED") // SUBMITTED, REVIEWING, PLANNED, IN_PROGRESS, COMPLETED
  assignedTo String? @db.Uuid // Platform team member
  resolution String?

  // Community engagement
  upvotes  Int               @default(0)
  comments FeedbackComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeedbackComment {
  id         String           @id @default(uuid()) @db.Uuid
  feedbackId String           @db.Uuid
  feedback   PlatformFeedback @relation(fields: [feedbackId], references: [id])

  commenterId String @db.Uuid
  commenter   User   @relation("FeedbackComment_User", fields: [commenterId], references: [id])

  comment    String
  isInternal Boolean @default(false) // Platform team internal notes

  createdAt DateTime @default(now())

  @@index([feedbackId, createdAt])
}

model CommunityDashboard {
  id     String @id @default(uuid()) @db.Uuid
  wardId String @db.Uuid
  ward   Ward   @relation(fields: [wardId], references: [id])

  // Key metrics
  metrics     Json // {activeUsers: 150, projectsCompleted: 12, economicActivity: 50000}
  trends      Json // Month-over-month changes
  comparisons Json // Comparison with similar communities

  // Customizable metrics
  customMetrics Json // Community-specific metrics they care about

  updatedAt DateTime @updatedAt
}

// MISSING: System-wide configuration
model SystemConfiguration {
  id          String   @id @default(uuid()) @db.Uuid
  configKey   String   @unique
  configValue Json
  description String?
  updatedBy   String   @db.Uuid
  updatedAt   DateTime @updatedAt

  // Relations
  updatedByUser User @relation(fields: [updatedBy], references: [id])
}

model EducationalModuleProject {
  moduleId String @db.Uuid
  projectId String @db.Uuid

  module EducationalModule @relation(fields: [moduleId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@id([moduleId, projectId])
}
