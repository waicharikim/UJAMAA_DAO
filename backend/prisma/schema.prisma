// -----------------------------------------------------
// PROJECT MODULE
// -----------------------------------------------------

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  CANCELLED
  COMPLETED
}

enum ProjectRole {
  LEAD
  MANAGER
  CONTRIBUTOR
  VIEWER
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  AWAITING_VERIFICATION
  VERIFIED
  REJECTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum WorkSessionStatus {
  OPEN
  APPROVED
  FLAGGED
}

model Project {
  id           String        @id @default(uuid()) @db.Uuid
  title        String
  description  String?       @db.Text
  coverImage   String?
  status       ProjectStatus @default(PLANNING)

  ownerGroupId String? @db.Uuid
  ownerUserId  String? @db.Uuid

  // NEW: Link to original proposal
  proposalId   String?  @unique @db.Uuid

  // RELATIONS
  ownerGroup         Group?              @relation("GroupProjects", fields: [ownerGroupId], references: [id])
  ownerUser          User?               @relation("UserProjects", fields: [ownerUserId], references: [id])
  proposal           Proposal?           @relation("ProposalToProject", fields: [proposalId], references: [id]) // NEW
  
  members            ProjectMember[]
  milestones         Milestone[]
  tasks              Task[]
  verifiers          MilestoneVerifier[]
  walletTransactions WalletTransaction[] @relation("ProjectTransactions")
  workLogs           PhysicalWorkLog[]
  workSessions       WorkSession[]
  comments           Comment[]           @relation("ProjectComments") // NEW

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerGroupId])
  @@index([ownerUserId])
  @@index([status])
  @@index([proposalId])
}

// ============================================================================
// UPDATED MILESTONE MODEL
// ============================================================================

model Milestone {
  id          String          @id @default(uuid())  @db.Uuid
  projectId   String          @db.Uuid
  title       String
  description String?         @db.Text
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?
  orderIndex  Int             @default(0)
  
  // NEW: Link to original proposal milestone
  proposalMilestoneId String?           @unique @db.Uuid

  // Submission & verification tracking
  startedAt             DateTime?
  submittedById         String?           @db.Uuid
  submittedAt           DateTime?
  proofUrl              String?
  submissionDescription String?           @db.Text
  verifiedById          String?           @db.Uuid
  verifiedAt            DateTime?
  feedback              String?           @db.Text

  // RELATIONS
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposalMilestone ProposalMilestone?  @relation("ProposalToProjectMilestone", fields: [proposalMilestoneId], references: [id]) // NEW
  submittedByUser   User?               @relation("MilestoneSubmitter", fields: [submittedById], references: [id])
  verifiedByUser    User?               @relation("MilestoneVerifier_VerifiedBy", fields: [verifiedById], references: [id])

  tasks        Task[]
  verifiers    MilestoneVerifier[]
  workLogs     PhysicalWorkLog[]
  workSessions WorkSession[]
  comments     Comment[]           @relation("MilestoneComments") // NEW

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([proposalMilestoneId])
}

model ProjectMember {
  id         String      @id @default(cuid())
  projectId  String      @db.Uuid
  userId     String      @db.Uuid
  role       ProjectRole @default(CONTRIBUTOR)

  project    Project     @relation(fields: [projectId], references: [id])
  user       User        @relation(fields: [userId], references: [id])

  joinedAt   DateTime    @default(now())

  @@unique([projectId, userId])
}


model Task {
  id            String         @id @default(cuid())
  projectId     String?        @db.Uuid
  milestoneId   String         @db.Uuid
  assignedToId  String?        @db.Uuid // a project member (User)
  title         String
  description   String?
  status        TaskStatus     @default(TODO)
  skillCategory String?
  maxAssignees  Int            @default(1)
  dueDate       DateTime?

  milestone     Milestone      @relation(fields: [milestoneId], references: [id])
  assignedTo    User?          @relation(fields: [assignedToId], references: [id])

  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model MilestoneVerifier {
  id            String             @id @default(cuid())
  milestoneId   String             @db.Uuid
  projectId     String?            @db.Uuid
  verifierId    String             @db.Uuid // a User OR a Group-appointed verifier
  assignedById  String             @db.Uuid // group admin or project lead
  status        VerificationStatus @default(PENDING)
  notes         String?

  milestone     Milestone          @relation(fields: [milestoneId], references: [id])
  verifier      User               @relation("MilestoneVerifier_Verifier", fields: [verifierId], references: [id])
  assignedBy    User               @relation("MilestoneVerifier_AssignedBy", fields: [assignedById], references: [id])

  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  
  @@unique([milestoneId, verifierId])
  @@index([milestoneId])
  @@index([verifierId])
  @@index([assignedById])
  @@index([status])
}

model WorkSession {
  id          String            @id @default(uuid()) @db.Uuid
  milestoneId String            @db.Uuid
  projectId   String            @db.Uuid
  createdById String            @db.Uuid
  qrSecret    String            @unique
  expiresAt   DateTime
  status      WorkSessionStatus @default(OPEN)
  closedAt    DateTime?
  closeJobId  String?

  milestone   Milestone         @relation(fields: [milestoneId], references: [id])
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("WorkSessionCreator", fields: [createdById], references: [id])
  presences   WorkPresence[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([milestoneId])
  @@index([projectId])
  @@index([status])
}

model WorkPresence {
  id          String       @id @default(uuid()) @db.Uuid
  sessionId   String       @db.Uuid
  userId      String       @db.Uuid
  attestedById String?     @db.Uuid
  depth       Int          @default(0)
  ipAwarded   Int          @default(0)
  awardedAt   DateTime?

  session     WorkSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User         @relation("WorkPresenceUser", fields: [userId], references: [id])
  attestedBy  User?        @relation("WorkPresenceAttestor", fields: [attestedById], references: [id])

  createdAt   DateTime     @default(now())

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}


// ============================================================================
// MODULE: TREASURY
// ============================================================================
// ============================================================================
// TREASURY MODULE - Prisma schema fragment
// (Place this in backend/src/modules/treasury/prisma/schema.prisma)
// ----------------------------------------------------------------------------
// NOTE:
//  - This file *extends* base models via relations (User, Group, Proposal, Project).
//  - Do NOT redeclare enums or models that exist in base.prisma (e.g. TransactionType).
//  - Keep module-specific models here and reference base models by id fields.
// ============================================================================

/// Module-specific enums (minimal; reuse core enums when available)
enum EscrowStatus {
  PENDING
  HELD
  RELEASED
  DISPUTED
  REFUNDED
}

enum TreasuryAction {
  ALLOCATE        // allocate money to a budget line
  FUND_RELEASE    // release funds for a project/milestone
  REFUND          // refund to payer
  ADJUSTMENT      // manual adjustment by admin
  FEE             // system fee
}

/// WALLET LEDGER / TREASURY CONTROLS

/** GroupTreasury
 * - One per Group (for group treasuries). System-wide treasuries (national) are represented
 *   by Group records for system groups (e.g. groupType = NATIONAL_CAMPAIGN).
 */
model GroupTreasury {
  id            String   @id @default(uuid()) @db.Uuid
  groupId       String   @db.Uuid
  group         Group    @relation(fields: [groupId], references: [id])

  // current on-ledger fiat balance (KES), kept for quick queries; authoritative ledger is transactions
  balance       Decimal  @db.Decimal(20, 2) @default(0)

  // optional: logical utility token balance (if group holds tokens separate from TokenBalance)
  tokenBalance  Int?     @default(0)

  // Multi-sig / governance rules
  multiSigPolicy Json?   // e.g. { thresholds: { small:1, medium:2, large:3 }, signers: [...] }
  spendingLimits Json?   // e.g. { daily: 10000, monthly: 100000 }

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  walletTransactions WalletTransaction[]    @relation("GroupTreasuryTransactions")
  escrows            Escrow[]               @relation("GroupTreasuryEscrows")

  duesAllocations DuesAllocation[]

  @@unique([groupId])
  @@index([groupId])
}


// ============================================================================
// UPDATED ESCROW - Add proposal relation
// ============================================================================

model Escrow {
  id                String        @id @default(uuid()) @db.Uuid
  treasuryId        String?       @db.Uuid
  amount            Decimal       @db.Decimal(20, 2)
  currency          String        @default("KES")
  status            EscrowStatus  @default(PENDING)
  createdById       String?       @db.Uuid
  releaseToId       String?       @db.Uuid
  releaseToType     HolderType?
  releaseReason     String?
  relatedProposalId String?       @db.Uuid
  createdAt         DateTime      @default(now())
  releasedAt        DateTime?
  disputeNotes      String?

  // RELATIONS
  treasury        GroupTreasury?  @relation("GroupTreasuryEscrows", fields: [treasuryId], references: [id])
  createdBy       User?           @relation(fields: [createdById], references: [id])
  relatedProposal Proposal?       @relation("ProposalEscrows", fields: [relatedProposalId], references: [id]) // UPDATED
  releases        EscrowRelease[]

  @@index([treasuryId])
  @@index([relatedProposalId])
  @@index([status])
}


/// EscrowRelease (audit trail for escrow movements)
model EscrowRelease {
  id         String    @id @default(uuid()) @db.Uuid
  escrowId   String    @db.Uuid
  escrow     Escrow    @relation(fields: [escrowId], references: [id])
  amount     Decimal   @db.Decimal(20, 2)
  releasedById String? @db.Uuid
  releasedBy User?     @relation(fields: [releasedById], references: [id])
  recipientId String?  @db.Uuid
  recipientType HolderType?
  note       String?
  createdAt  DateTime  @default(now())

  @@index([escrowId])
}

/// TreasuryPolicy: group / system policies about fees, limits, quotas
model TreasuryPolicy {
  id         String   @id @default(uuid()) @db.Uuid
  groupId    String?  @db.Uuid   // null => system/global policy
  group      Group?   @relation(fields: [groupId], references: [id])
  key        String   // e.g. "fee.fixed_pct", "spend.limit_daily"
  value      String   // JSON/text
  description String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([groupId, key])
}

/// Audit table for treasury-related actions (fine-grained)
model TreasuryAudit {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String?  @db.Uuid
  escrowId      String?  @db.Uuid
  action        String
  payload       Json?
  actorId       String?  @db.Uuid
  actor         User?    @relation(fields: [actorId], references: [id])
  createdAt     DateTime @default(now())

  @@index([transactionId])
  @@index([escrowId])
}

// ============================================================================
// WALLET TRANSACTIONS
// The on-ledger record of every credit/debit to a GroupTreasury.
// Referenced by governance (Proposal), projects (Project), and treasury itself.
// ============================================================================

model WalletTransaction {
  id              String        @id @default(uuid()) @db.Uuid
  treasuryId      String        @db.Uuid
  amount          Decimal       @db.Decimal(20, 2)
  currency        String        @default("KES")
  transactionType String        // "CREDIT", "DEBIT"
  description     String?
  referenceType   String?       // "PROPOSAL", "PROJECT", "DUES", "ESCROW", "MANUAL"
  proposalId      String?       @db.Uuid
  projectId       String?       @db.Uuid
  initiatedById   String?       @db.Uuid
  metadata        Json?
  createdAt       DateTime      @default(now())

  treasury GroupTreasury @relation("GroupTreasuryTransactions", fields: [treasuryId], references: [id], onDelete: Cascade)
  proposal Proposal?     @relation("ProposalTransactions", fields: [proposalId], references: [id], onDelete: SetNull)
  project  Project?      @relation("ProjectTransactions", fields: [projectId], references: [id], onDelete: SetNull)

  @@index([treasuryId, createdAt])
  @@index([proposalId])
  @@index([projectId])
  @@index([createdAt])
  @@map("wallet_transactions")
}



// ============================================================================
// MODULE: MARKETPLACE
// ============================================================================
// ============================================================================
// MARKETPLACE MODULE - Listings, Transactions, Reviews
// ============================================================================

enum ListingStatus {
  ACTIVE
  INACTIVE
  REMOVED
  SUSPENDED
}

enum MarketplaceTransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

model MarketplaceListing {
  id            String        @id @default(uuid()) @db.Uuid
  title         String
  description   String
  price         Decimal       @db.Decimal(20, 2)
  quantity      Int           @default(1)
  listingType   String
  marketTier    String        @default("LOCAL")
  wardId        String?       @db.Uuid
  sellerType    HolderType
  sellerUserId  String?       @db.Uuid
  sellerGroupId String?       @db.Uuid
  status        ListingStatus @default(ACTIVE)
  verified      Boolean       @default(false)
  qualityRating Decimal       @default(0) @db.Decimal(3, 2)
  views         Int           @default(0)
  salesCount    Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  ward        Ward?                    @relation(fields: [wardId], references: [id], onDelete: SetNull)
  sellerUser  User?                    @relation("UserListings", fields: [sellerUserId], references: [id], onDelete: SetNull)
  sellerGroup Group?                   @relation("GroupListings", fields: [sellerGroupId], references: [id], onDelete: SetNull)
  transactions MarketplaceTransaction[]
  reviews     MarketplaceReview[]

  @@index([wardId, status])
  @@index([sellerUserId])
  @@index([sellerGroupId])
  @@index([status])
}

model MarketplaceTransaction {
  id              String                       @id @default(uuid()) @db.Uuid
  listingId       String                       @db.Uuid
  buyerId         String                       @db.Uuid
  sellerId        String                       @db.Uuid
  sellerType      HolderType
  quantity        Int
  totalPrice      Decimal                      @db.Decimal(20, 2)
  status          MarketplaceTransactionStatus @default(PENDING)
  escrowRelease   Boolean                      @default(false)
  deliveryDetails Json?
  completedAt     DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  listing    MarketplaceListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer      User                @relation("Buyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerUser User?               @relation("Seller", fields: [sellerId], references: [id], onDelete: SetNull)
  review     MarketplaceReview?

  @@index([buyerId])
  @@index([listingId])
  @@index([status])
}

model MarketplaceReview {
  id               String                 @id @default(uuid()) @db.Uuid
  transactionId    String                 @unique @db.Uuid
  listingId        String                 @db.Uuid
  reviewerId       String                 @db.Uuid
  reviewedId       String                 @db.Uuid
  reviewedType     HolderType
  rating           Int
  comment          String?
  verifiedPurchase Boolean                @default(true)
  createdAt        DateTime               @default(now())

  transaction MarketplaceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  listing     MarketplaceListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reviewer    User                   @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([reviewedId, reviewedType])
  @@index([reviewerId])
  @@index([listingId])
}



// ============================================================================
// MODULE: EDUCATION
// ============================================================================
// ============================================================================
// EDUCATION MODULE - Learning Content, Progress, Assessments
// ============================================================================

enum EducationalContentLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model EducationalModule {
  id             String                  @id @default(uuid()) @db.Uuid
  title          String
  description    String
  content        String
  mediaUrls      String[]
  duration       Int
  difficulty     EducationalContentLevel
  category       String
  creatorId      String                  @db.Uuid
  groupId        String?                 @db.Uuid
  verified       Boolean                 @default(false)
  expertApproved Boolean                 @default(false)
  completionIP   Int                     @default(0)
  views          Int                     @default(0)
  averageRating  Decimal                 @default(0) @db.Decimal(3, 2)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  creator     User                      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  progress    UserEducationalProgress[]
  assessments EducationalAssessment[]
  reviews     EducationalReview[]

  @@index([creatorId])
  @@index([category, verified])
  @@index([difficulty])
}

model UserEducationalProgress {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  moduleId    String    @db.Uuid
  status      String    @default("IN_PROGRESS")
  progress    Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  score       Int?

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  module EducationalModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId, status])
}

model EducationalAssessment {
  id           String   @id @default(uuid()) @db.Uuid
  moduleId     String   @db.Uuid
  questions    Json
  passingScore Int      @default(70)
  maxAttempts  Int      @default(3)
  createdAt    DateTime @default(now())

  module EducationalModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model EducationalReview {
  id        String   @id @default(uuid()) @db.Uuid
  moduleId  String   @db.Uuid
  userId    String   @db.Uuid
  rating    Int
  comment   String?
  helpful   Int      @default(0)
  createdAt DateTime @default(now())

  module EducationalModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([moduleId])
  @@index([userId])
}



// ============================================================================
// MODULE: EMERGENCY
// ============================================================================
// ============================================================================
// EMERGENCY MODULE - Alerts, Response Coordination
// ============================================================================

enum EmergencyType {
  FIRE
  FLOOD
  MEDICAL
  SECURITY
  ACCIDENT
  OTHER
}

enum EmergencySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model EmergencyAlert {
  id                 String            @id @default(uuid()) @db.Uuid
  title              String
  description        String
  emergencyType      EmergencyType
  severity           EmergencySeverity
  location           String
  reporterId         String            @db.Uuid
  status             String            @default("ACTIVE")
  assignedGroupId    String?           @db.Uuid
  neededResources    Json
  availableResources Json
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  resolvedAt     DateTime?
  resolvedById   String?           @db.Uuid
  statusNote     String?           @db.VarChar(500)

  reporter   User               @relation("EmergencyAlertReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User?              @relation("EmergencyAlertResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  group      Group?             @relation(fields: [assignedGroupId], references: [id], onDelete: SetNull)
  responses  EmergencyResponse[]

  @@index([reporterId])
  @@index([assignedGroupId])
  @@index([severity, status])
}

model EmergencyResponse {
  id          String   @id @default(uuid()) @db.Uuid
  emergencyId String   @db.Uuid
  userId      String   @db.Uuid
  role        String
  status      String   @default("AVAILABLE")
  skills      String[]
  location    String?
  notes       String?
  createdAt   DateTime @default(now())

  emergency EmergencyAlert @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([emergencyId, userId])
  @@index([userId])
  @@index([emergencyId, status])
}



// ============================================================================
// MODULE: REPUTATION
// ============================================================================
// ============================================================================
// REPUTATION MODULE - Impact Points (Global + Location-Based)
// ============================================================================

model ImpactPointLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  amount    Int
  reason    String   @db.VarChar(100)
  scope     String   @db.VarChar(50)  // "GLOBAL" | "WARD" | "CONSTITUENCY" | "COUNTY"
  scopedId  String?  @db.Uuid         // Ward/Constituency/County ID when scope != GLOBAL
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation("UserImpactPointLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scope])
  @@index([createdAt])
  @@map("impact_point_logs")
}

model UserLocationImpact {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  wardId       String   @db.Uuid
  impactPoints Int      @default(0)
  tier         String   @default("NONE")  // NONE | BRONZE | SILVER | GOLD | PLATINUM
  type         String   @default("LOCATION_BASED")
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation("UserLocationImpacts", fields: [userId], references: [id], onDelete: Cascade)
  ward Ward @relation("WardLocationImpacts", fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([userId, wardId])
  @@index([userId])
  @@index([wardId])
  @@map("user_location_impacts")
}



// ============================================================================
// MODULE: NOTIFICATIONS
// ============================================================================
// ============================================================================
// AUDIT MODULE - Notifications, Logs, Privacy, Feedback
// ============================================================================

enum NotificationType {
  SYSTEM
  PROPOSAL
  VERIFICATION
  ECONOMIC
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  title     String
  message   String
  type      NotificationType     @default(SYSTEM)
  priority  NotificationPriority @default(NORMAL)
  read      Boolean              @default(false)
  actionUrl String?
  metadata  Json?
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@index([priority, read])
}

model NotificationPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  channel   String
  category  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, category])
  @@index([userId])
}

model UserAudit {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  action    String
  details   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, action])
  @@index([createdAt])
}

model UserConsent {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  policyKey  String
  accepted   Boolean   @default(false)
  version    String
  acceptedAt DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, policyKey])
  @@index([userId, accepted])
}

model PlatformFeedback {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  category    String
  description String
  rating      Int?
  status      String   @default("NEW")
  response    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([category, status])
  @@index([userId])
}

model SystemLog {
  id        String   @id @default(uuid()) @db.Uuid
  level     String
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
}



// ============================================================================
// MODULE: AUDIT
// ============================================================================
// ============================================================================
// MODULE: AUDIT
// Immutable action log — viewable by scoped admins
// ============================================================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.Uuid
  metadata   Json?

  createdAt  DateTime @default(now())

  user User? @relation("UserAuditLog", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}



// ============================================================================
// MODULE: ADMIN
// ============================================================================
// ============================================================================
// MODULE: PLATFORM CONFIG
// Key/value store for platform operational settings (costs, dues tiers, etc.)
// ============================================================================

model PlatformConfig {
  key         String   @id @db.VarChar(100)
  value       String   @db.VarChar(500)
  label       String   @db.VarChar(200)
  category    String   @db.VarChar(50)
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  updatedBy   User?    @relation("PlatformConfigUpdates", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("platform_config")
}



// ============================================================================
// MODULE: PAYMENTS
// ============================================================================
// ============================================================================
// PAYMENTS MODULE — Flutterwave (M-Pesa STK Push + Card)
// ============================================================================

model PaymentRecord {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  txRef        String    @unique  // Our generated reference
  flwRef       String?            // Flutterwave's reference (set on webhook)
  amount       Decimal   @db.Decimal(10, 2)
  currency     String    @default("KES")
  method       String    // "MPESA" | "CARD"
  purpose      String    // "DUES" | "VERIFICATION" | "TREASURY_DEPOSIT"
  purposeMeta  Json?     // { tier, period, groupId } etc
  status       String    @default("PENDING") // PENDING | COMPLETED | FAILED
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([txRef])
  @@index([flwRef])
  @@index([status])
  @@map("payment_records")
}
