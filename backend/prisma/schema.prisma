generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// SHARED ENUMS
// These are referenced by multiple module schemas and MUST appear first
// in the merged output so module schemas can reference them safely.
// ============================================================================

enum LocationScope {
  WARD
  CONSTITUENCY
  COUNTY
  NATIONAL
}

enum GroupStatus {
  FORMING      // Initial creation, gathering members
  ACTIVE       // Fully operational
  SUSPENDED    // Temporarily inactive (violations, disputes)
  INACTIVE     // No activity for extended period
  DISSOLVED    // Permanently closed
  MERGED       // Combined with another group
}

enum GroupRole {
  MEMBER       // Regular member
  LEADER       // Group leader/chairperson
  TREASURER    // Financial manager
  SECRETARY    // Records keeper
  AUDITOR      // Financial oversight
  FACILITATOR  // Meeting coordinator
  MENTOR       // Advisor role
  MODERATOR    // Content/discussion moderator
}

enum HolderType {
  USER
  GROUP
  SYSTEM
}

// ============================================================================
// GEOGRAPHIC MODELS
// ============================================================================

model County {
  id             String         @id @default(uuid()) @db.Uuid
  code           String         @unique
  name           String         @unique
  constituencies Constituency[]
  wards          Ward[]

  // Community module back-relation
  groups         Group[]        @relation("CountyGroups")
  elections      Election[]     @relation("CountyElections")

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("counties")
}

model Constituency {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  countyId  String   @db.Uuid
  county    County   @relation(fields: [countyId], references: [id], onDelete: Cascade)
  wards     Ward[]

  // Community module back-relation
  groups    Group[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, countyId])
  @@index([countyId])
  @@map("constituencies")
}

model Ward {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  code           String?      @unique
  constituencyId String       @db.Uuid
  countyId       String       @db.Uuid
  constituency   Constituency @relation(fields: [constituencyId], references: [id], onDelete: Cascade)
  county         County       @relation(fields: [countyId], references: [id], onDelete: Cascade)

  // User module — primary/secondary/current ward
  usersPrimary   User[]       @relation("PrimaryWard")
  usersSecondary User[]       @relation("SecondaryWard")
  usersCurrent   User[]       @relation("CurrentWard")

  // User module — residence change requests
  newWardRequests ResidenceChangeRequest[] @relation("NewWardRequests")
  oldWardRequests ResidenceChangeRequest[] @relation("OldWardRequests")

  // Community module
  groups          Group[]          @relation("GroupWard")
  communityAssets CommunityAsset[]
  communityVouches CommunityVouch[]

  // Marketplace module
  marketplaceListings MarketplaceListing[]

  // Reputation module
  locationImpacts UserLocationImpact[] @relation("WardLocationImpacts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([constituencyId])
  @@index([countyId])
  @@map("wards")
}

// ============================================================================
// INDUSTRY MODELS
// ============================================================================

model Industry {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @unique
  goodsServices  GoodsService[]
  userIndustries UserIndustry[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("industries")
}

model GoodsService {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  description       String?
  industryId        String             @db.Uuid
  category          String?
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  industry          Industry           @relation(fields: [industryId], references: [id], onDelete: Cascade)
  userGoodsServices UserGoodsService[]

  @@unique([name, industryId])
  @@index([industryId])
  @@index([industryId, active])
  @@map("goods_services")
}

// ============================================================================
// CORE USER MODEL
// Back-relations are declared for every module that references User.
// When module schemas are merged in, Prisma resolves these cross-file relations.
// ============================================================================

model User {
  id                   String    @id @default(uuid()) @db.Uuid
  email                String?   @unique
  name                 String?
  phoneNumber          String?
  walletAddress        String?   @unique
  passwordHash         String?   @db.Text // For admin accounts only
  avatarUrl            String?

  // Ward assignments
  primaryWardId        String?   @db.Uuid
  secondaryWardId      String?   @db.Uuid
  currentLocationId    String?   @db.Uuid
  currentLocationUntil DateTime?

  primaryWard          Ward?     @relation("PrimaryWard", fields: [primaryWardId], references: [id], onDelete: SetNull)
  secondaryWard        Ward?     @relation("SecondaryWard", fields: [secondaryWardId], references: [id], onDelete: SetNull)
  currentWard          Ward?     @relation("CurrentWard", fields: [currentLocationId], references: [id], onDelete: SetNull)

  // Verification status
  verificationLevel    String    @default("UNVERIFIED")
  emailVerified        Boolean   @default(false)
  phoneVerified        Boolean   @default(false)
  communityVerified    Boolean   @default(false)
  locationVerified     Boolean   @default(false)

  // Economy
  participationRights  Int       @default(0)
  fiatBackedUtBalance  Int       @default(0) // M-Pesa deposits — 1 UT = 1 KES, cashable back
  earnedUtBalance      Int       @default(0) // Platform activity rewards — no cash-out path
  globalImpactPoints   Int       @default(0)

  // Account status
  status               String    @default("ACTIVE") // ACTIVE, SUSPENDED, BANNED

  // Roles (convenience array — authoritative source is UserRole table)
  roles                String[]  @default([])

  // Timestamps
  onboardingCompletedAt  DateTime?
  lastResidenceChangeAt  DateTime?
  lastLoginAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // ---- Auth module ----
  sessions              Session[]
  loginEvents           LoginEvent[]
  verificationTokens    EmailVerificationToken[]
  accounts              Account[]
  recoveryRequests      RecoveryRequest[]
  phoneVerifications    PhoneVerification[]
  passwordResets        PasswordReset[]
  twoFactorAuth         TwoFactorAuth?
  webauthnCredentials   WebAuthnCredential[]
  accountRecovery       AccountRecovery?
  securityEvents        SecurityEvent[]
  messagingProfiles     UserMessagingProfile[]

  // ---- User module ----
  userIndustries            UserIndustry[]
  userGoodsServices         UserGoodsService[]
  privacySettings           UserPrivacySettings?
  accessibility             UserAccessibility?
  residenceChangeRequests   ResidenceChangeRequest[] @relation("UserResidenceRequests")
  reviewedResidenceRequests ResidenceChangeRequest[] @relation("ResidenceRequestReviewer")
  participationRightsLogs   ParticipationRightsLog[]
  onboardingProgress        OnboardingProgress?
  tutorialCompletions       UserTutorialCompletion[]
  onboardingMilestones      OnboardingMilestone[]

  // ---- Roles (base) ----
  userRoles                 UserRole[]

  // ---- Community module ----
  groupMemberships          GroupMember[]
  complainantCases          ConflictCase[]         @relation("Complainant")
  respondentCases           ConflictCase[]         @relation("Respondent")
  comments                  Comment[]
  organizedEvents           Event[]
  eventAttendances          EventAttendee[]
  engagementMetrics         UserEngagementMetric[]
  verificationRequests      VerificationRequest[]
  vouchedFor                CommunityVouch[]       @relation("VouchedFor")
  vouchesGiven              CommunityVouch[]       @relation("VouchesGiven")
  barazaAttendances         BarazaAttendance[]

  // ---- Governance module ----
  proposals                 Proposal[]             @relation("UserProposals")
  reviewedProposals         Proposal[]             @relation("ProposalReviewer")
  votes                     GroupMemberVote[]      @relation("UserVotes")

  // ---- Projects module ----
  ownedProjects             Project[]              @relation("UserProjects")
  projectMemberships        ProjectMember[]
  assignedTasks             Task[]
  verifierAssignments       MilestoneVerifier[]    @relation("MilestoneVerifier_Verifier")
  assignedVerifications     MilestoneVerifier[]    @relation("MilestoneVerifier_AssignedBy")
  submittedMilestones       Milestone[]            @relation("MilestoneSubmitter")
  verifiedMilestones        Milestone[]            @relation("MilestoneVerifier_VerifiedBy")
  createdWorkSessions       WorkSession[]          @relation("WorkSessionCreator")
  workPresences             WorkPresence[]         @relation("WorkPresenceUser")
  attestedPresences         WorkPresence[]         @relation("WorkPresenceAttestor")

  // ---- Economy module ----
  duesPayments              DuesPayment[]
  physicalWorkLogs          PhysicalWorkLog[]
  workVerifications         WorkVerification[]     @relation("WorkVerifier")
  commitments               Commitment[]
  utWithdrawals             UtWithdrawal[]

  // ---- Elections module ----
  electionCandidacies       ElectionCandidate[]    @relation("ElectionCandidates")
  electionVotes             ElectionVote[]         @relation("ElectionVoters")
  wonElections              Election[]             @relation("ElectionWinners")

  // ---- Treasury module ----
  createdEscrows            Escrow[]
  escrowReleases            EscrowRelease[]
  treasuryAudits            TreasuryAudit[]

  // ---- Marketplace module ----
  marketplaceListings       MarketplaceListing[]   @relation("UserListings")
  marketplacePurchases      MarketplaceTransaction[] @relation("Buyer")
  marketplaceSales          MarketplaceTransaction[] @relation("Seller")
  marketplaceReviews        MarketplaceReview[]    @relation("Reviewer")

  // ---- Notifications module ----
  notifications             Notification[]
  notificationPreferences   NotificationPreference[]
  auditLogs                 UserAudit[]
  auditLogEntries           AuditLog[]                 @relation("UserAuditLog")
  consents                  UserConsent[]
  feedback                  PlatformFeedback[]

  // ---- Education module ----
  educationalModules        EducationalModule[]
  educationalProgress       UserEducationalProgress[]
  educationalReviews        EducationalReview[]

  // ---- Emergency module ----
  emergencyAlerts           EmergencyAlert[]   @relation("EmergencyAlertReporter")
  resolvedEmergencies       EmergencyAlert[]   @relation("EmergencyAlertResolver")
  emergencyResponses        EmergencyResponse[]

  // ---- Reputation module ----
  impactPointLogs           ImpactPointLog[]       @relation("UserImpactPointLogs")
  locationImpacts           UserLocationImpact[]   @relation("UserLocationImpacts")

  // ---- Payments module ----
  paymentRecords            PaymentRecord[]

  // ---- System ----
  updatedConfigs            SystemConfiguration[]  @relation("ConfigUpdater")
  platformConfigUpdates     PlatformConfig[]       @relation("PlatformConfigUpdates")

  @@index([email])
  @@index([walletAddress])
  @@index([phoneNumber])
  @@index([primaryWardId])
  @@index([verificationLevel])
  @@index([status])
  @@map("users")
}

// ============================================================================
// ROLES SYSTEM
// ============================================================================

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique // ADMIN, SUPER_ADMIN, MODERATOR, etc.
  description String?
  permissions String[]   @default([])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  active    Boolean  @default(true)
  grantedAt DateTime @default(now())
  grantedBy String?  @db.Uuid
  revokedAt DateTime?
  revokedBy String?  @db.Uuid

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId, active])
  @@index([roleId])
  @@map("user_roles")
}

// ============================================================================
// SYSTEM CONFIGURATION
// ============================================================================

model SystemConfiguration {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  category    String
  description String?
  dataType    String
  isPublic    Boolean  @default(false)

  updatedBy   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updater     User?    @relation("ConfigUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([isPublic])
  @@index([dataType])
  @@map("system_configuration")
}

// ============================================================================
// MODULE: AUTH
// ============================================================================
// ============================================================================
// AUTH MODULE - Authentication & Session Management
// ============================================================================

enum MessagingPlatform {
  TELEGRAM
  WHATSAPP
  DISCORD
}

model UserMessagingProfile {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  platform       MessagingPlatform
  handle         String?           // @username for Telegram/Discord; null for WhatsApp (phone already stored)
  externalUserId String?           // platform-assigned user ID, populated by bot on first interaction
  isVerified     Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([platform, externalUserId])
  @@map("user_messaging_profiles")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  token        String    @unique
  deviceName   String?   @db.VarChar(100)
  deviceInfo   String?   @db.VarChar(500)
  ipAddress    String?   @db.VarChar(45)
  userAgent    String?   @db.Text
  isTrusted    Boolean   @default(false)
  lastActive   DateTime  @default(now())
  expiresAt    DateTime
  revoked      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revoked])
  @@index([token])
  @@index([expiresAt])
  @@index([lastActive])
  @@map("sessions")
}

model Account {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  provider          String    // "google", "twitter", "facebook", etc.
  providerAccountId String
  accessToken       String?   @db.Text
  refreshToken      String?   @db.Text
  expiresAt         DateTime?
  tokenType         String?
  scope             String?
  idToken           String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model RecoveryRequest {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  recoveryMethod   String   // "EMAIL", "WALLET", "RECOVERY_WALLET"
  verificationCode String   @unique
  status           String   @default("PENDING")
  expiresAt        DateTime
  completedAt      DateTime?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([verificationCode])
  @@index([expiresAt])
  @@map("recovery_requests")
}

model LoginEvent {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  method        String    // "MAGIC_LINK", "WALLET", "OAUTH"
  ipAddress     String?
  userAgent     String?
  location      String?
  successful    Boolean
  failureReason String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([successful])
  @@index([createdAt])
  @@map("login_events")
}

model PhoneVerification {
  id          String    @id @default(uuid()) @db.Uuid
  phoneNumber String    @db.VarChar(15)
  code        String    @db.VarChar(6)
  userId      String?   @db.Uuid
  verified    Boolean   @default(false)
  verifiedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([phoneNumber, verified])
  @@index([phoneNumber])
  @@index([verified])
  @@index([expiresAt])
  @@index([userId])
  @@map("phone_verifications")
}

// ============================================================================
// PASSWORD RESET (Admin only)
// ============================================================================

model PasswordReset {
  id        String   @id @default(cuid())

  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tokenHash String   @db.Text  // Hashed token (never store plaintext)
  
  used      Boolean  @default(false)
  usedAt    DateTime?

  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tokenHash, used, expiresAt])
  @@index([userId])
  @@index([expiresAt]) // For cleanup
  @@map("password_resets")
}

// ============================================================================
// TOTP 2FA (Google Authenticator)
// ============================================================================

model TwoFactorAuth {
  id                      String   @id @default(cuid())
  
  userId                  String   @unique @db.Uuid
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // TOTP secret (encrypted)
  secretEncrypted         String   @db.Text
  
  // Backup codes (encrypted array)
  backupCodesEncrypted    String[] // Each is an encrypted backup code
  
  enabled                 Boolean  @default(false)
  enabledAt               DateTime?
  disabledAt              DateTime?

  failedAttempts          Int      @default(0)
  lastFailedAttempt       DateTime?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([userId, enabled])
  @@map("two_factor_auth")
}

// ============================================================================
// WEBAUTHN / PASSKEYS (Biometric, Security Keys)
// ============================================================================

model WebAuthnCredential {
  id            String   @id @default(cuid())
  
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // WebAuthn credential data
  credentialId  String   @unique  // Base64url encoded credential ID
  publicKey     String   @db.Text // Base64url encoded public key
  counter       BigInt   @default(0) // Signature counter for replay protection
  
  // Credential metadata
  credentialName String?  @db.VarChar(100) // User-friendly name "Touch ID", "YubiKey"
  aaguid        String?  @db.VarChar(36)  // Authenticator GUID
  
  // Device info
  transports    String[] // ["usb", "nfc", "ble", "internal"]
  
  // Timestamps
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())
  
  @@index([userId])
  @@index([credentialId])
  @@map("webauthn_credentials")
}

model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  userId    String?  @db.Uuid   // set for registration; null for login
  email     String?  @db.VarChar(255) // set for login lookup
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([challenge])
  @@index([expiresAt])
  @@map("webauthn_challenges")
}

// ============================================================================
// MAGIC LINK TOKENS (with expiry)
// ============================================================================

model MagicLinkToken {
  id        String   @id @default(cuid())
  
  email     String   @db.VarChar(255)
  tokenHash String   @unique @db.Text // Hashed token
  
  type      String   @db.VarChar(20) // "verification" or "login"
  
  used      Boolean  @default(false)
  usedAt    DateTime?
  
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([tokenHash, used, expiresAt])
  @@index([email])
  @@index([expiresAt]) // For cleanup
  @@map("magic_link_tokens")
}

// ============================================================================
// ACCOUNT RECOVERY (Trusted contacts, recovery codes)
// ============================================================================

model AccountRecovery {
  id                  String   @id @default(cuid())
  
  userId              String   @unique @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Recovery codes (encrypted, like 2FA backup codes but more)
  recoveryCodesEncrypted String[] // 20 codes for account recovery
  
  // Trusted contacts (email addresses that can help recover account)
  trustedContactEmails   String[] // Up to 3 trusted contacts
  
  // Recovery email (different from primary)
  recoveryEmail       String?  @db.VarChar(255)
  recoveryEmailVerified Boolean @default(false)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@index([userId])
  @@map("account_recovery")
}

// ============================================================================
// SECURITY EVENTS (Audit log for suspicious activity)
// ============================================================================

model SecurityEvent {
  id          String   @id @default(cuid())
  
  userId      String?  @db.Uuid // Nullable for failed login attempts
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  eventType       String   @db.VarChar(50) // "login_failed", "password_reset", "2fa_disabled", etc.
  severity        String   @db.VarChar(20) // "low", "medium", "high", "critical"
  description     String?  @db.Text

  ipAddress       String?  @db.VarChar(45)
  userAgent       String?  @db.Text
  location        String?  @db.VarChar(100) // City, Country

  metadata        Json?    // Additional context

  resolved        Boolean  @default(false)
  resolvedAt      DateTime?
  resolvedBy      String?  @db.Uuid // Admin user ID
  resolutionNotes String?  @db.Text

  createdAt       DateTime @default(now())
  
  @@index([userId, createdAt])
  @@index([eventType, severity])
  @@index([createdAt])
  @@map("security_events")
}



// ============================================================================
// MODULE: USER
// ============================================================================
// ============================================================================
// USER MODULE - Profile, Industries, Privacy, Accessibility
// ============================================================================

model ResidenceChangeRequest {
  id               String                 @id @default(uuid()) @db.Uuid
  userId           String                 @db.Uuid
  oldWardId        String?                @db.Uuid
  newPrimaryWardId String                 @db.Uuid
  reason           String?                 
  proofUrl         String?
  status           ResidenceChangeStatus  @default(PENDING)
  reviewedBy       String?                @db.Uuid
  reviewedAt       DateTime?
  rejectionReason  String?
  expiresAt        DateTime // Auto-reject after 7 days
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user     User  @relation("UserResidenceRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ResidenceRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  newWard  Ward  @relation("NewWardRequests", fields: [newPrimaryWardId], references: [id], onDelete: Cascade)
  oldWard  Ward? @relation("OldWardRequests", fields: [oldWardId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, expiresAt])
}

enum ResidenceChangeStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model UserIndustry {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  industryId String   @db.Uuid
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  industry Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@unique([userId, industryId])
  @@index([userId])
  @@index([industryId])
}

model UserGoodsService {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  goodsServiceId String   @db.Uuid
  canProvide     Boolean  @default(false)
  canRequest     Boolean  @default(false)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goodsService GoodsService @relation(fields: [goodsServiceId], references: [id], onDelete: Cascade)

  @@unique([userId, goodsServiceId])
  @@index([userId])
  @@index([goodsServiceId])
}

model UserPrivacySettings {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid
  profileVisibility     String   @default("PUBLIC") // PUBLIC, FRIENDS, PRIVATE
  showEmail             Boolean  @default(false)
  showPhone             Boolean  @default(false)
  showWallet            Boolean  @default(false)
  showImpactPoints      Boolean  @default(true)
  allowDirectMessages   Boolean  @default(true)
  allowMarketplace      Boolean  @default(true)
  dataProcessingConsent Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserAccessibility {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @db.Uuid
  visualImpairment    Boolean  @default(false)
  hearingImpairment   Boolean  @default(false)
  motorImpairment     Boolean  @default(false)
  cognitiveImpairment Boolean  @default(false)
  preferredLanguage   String   @default("en")
  screenReaderEnabled Boolean  @default(false)
  highContrast        Boolean  @default(false)
  fontSize            String   @default("MEDIUM") // SMALL, MEDIUM, LARGE, XLARGE
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// PARTICIPATION RIGHTS
// ============================================================================

model ParticipationRightsLog {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  amount            Int // Can be positive (earned) or negative (spent)
  balance           Int // PR balance after this transaction
  reason            String // "DUES_PAID", "VOTED", "CREATED_PROPOSAL", "MONTHLY_REGEN"
  relatedEntityType String?
  relatedEntityId   String?  @db.Uuid
  metadata          Json?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([reason])
}

// ============================================================================
// ONBOARDING
// ============================================================================

model OnboardingProgress {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  // Account setup
  emailVerified         Boolean @default(false)
  profileCompleted      Boolean @default(false)
  industriesSelected    Boolean @default(false)
  goodsServicesSelected Boolean @default(false)
  privacyConfigured     Boolean @default(false)

  // Tutorials
  platformIntroCompleted       Boolean @default(false)
  governanceTutorialCompleted  Boolean @default(false)
  marketplaceTutorialCompleted Boolean @default(false)
  projectsTutorialCompleted    Boolean @default(false)
  groupsTutorialCompleted      Boolean @default(false)

  // First actions
  joinedWardGroup      Boolean @default(false)
  joinedVoluntaryGroup Boolean @default(false)
  castFirstVote        Boolean @default(false)
  completedFirstModule Boolean @default(false)
  attendedFirstEvent   Boolean @default(false)
  createdFirstListing  Boolean @default(false)

  // Verification steps
  phoneVerified     Boolean @default(false)
  communityVerified Boolean @default(false)
  locationVerified  Boolean @default(false)
  walletConnected   Boolean @default(false)

  // Financial
  paidFirstDues Boolean @default(false)

  // Metadata
  currentStep    String  @default("EMAIL_VERIFICATION")
  lastActiveStep String?
  totalIPEarned  Int     @default(0)
  totalPREarned  Int     @default(0)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentStep])
}

model OnboardingTutorial {
  id               String   @id @default(uuid()) @db.Uuid
  key              String   @unique // "platform_intro", "governance_basics"
  title            String
  description      String
  content          Json // Tutorial steps, images, videos, quiz questions
  category         String // "BASICS", "GOVERNANCE", "MARKETPLACE", "PROJECTS", "GROUPS"
  order            Int // Display order within category
  requiredFor      String? // "VOTING", "MARKETPLACE_SELLING", null
  ipReward         Int      @default(0)
  prReward         Int      @default(0)
  isOptional       Boolean  @default(true)
  active           Boolean  @default(true)
  estimatedMinutes Int      @default(5)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  completions UserTutorialCompletion[]

  @@index([category, order])
  @@index([active])
}

model UserTutorialCompletion {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tutorialId String   @db.Uuid

  completed Boolean @default(false)
  progress  Int     @default(0) // Percentage (0-100)
  skipped   Boolean @default(false)
  ipEarned  Int     @default(0)
  prEarned  Int     @default(0)
  quizScore Int? // If tutorial has quiz

  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  lastViewedAt DateTime  @default(now())

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tutorial OnboardingTutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  @@unique([userId, tutorialId])
  @@index([userId, completed])
  @@index([tutorialId, completed])
}

model OnboardingMilestone {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  milestoneKey String // "FIRST_VOTE", "FIRST_PROPOSAL", "FIRST_LISTING"

  achieved   Boolean  @default(true)
  ipEarned   Int
  prEarned   Int      @default(0)
  metadata   Json? // Extra context about the achievement
  achievedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, milestoneKey])
  @@index([userId, achievedAt])
  @@index([milestoneKey])
}



// ============================================================================
// MODULE: ECONOMY
// ============================================================================
// ============================================================================
// ECONOMY MODULE - Dues, Payments, Physical Work
// ============================================================================

enum VerificationMethod {
  PEER
  SUPERVISOR
  COMMUNITY_WITNESS
  DIGITAL_EVIDENCE
  EXPERT_REVIEW
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DuesTier {
  ORDINARY // KES 60/month
  SUPPORTER // KES 200/month
  SPONSOR // KES 1000/month
}

model DuesPayment {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  totalAmount   Decimal       @db.Decimal(10, 2)
  tier          DuesTier
  period        String        // "2025-01" (YYYY-MM format)
  
  // Payment details
  paymentMethod String        // MPESA, BANK_TRANSFER, WALLET
  mpesaReceipt  String?
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  
  // NEW: Flexible allocation to multiple groups
  allocations   DuesAllocation[]
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([userId, status])
  @@index([period, status])
  @@index([paidAt])
}


model DuesAllocation {
  id             String      @id @default(uuid()) @db.Uuid
  duesPaymentId  String      @db.Uuid
  groupId        String      @db.Uuid
  amount         Decimal     @db.Decimal(10, 2)
  percentage     Decimal     @db.Decimal(5, 2)  // What % of total payment
  
  // Track which treasury received it
  treasuryId     String      @db.Uuid
  
  createdAt      DateTime    @default(now())
  
  duesPayment    DuesPayment    @relation(fields: [duesPaymentId], references: [id], onDelete: Cascade)
  group          Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  treasury       GroupTreasury  @relation(fields: [treasuryId], references: [id], onDelete: Cascade)
  
  @@index([duesPaymentId])
  @@index([groupId])
  @@index([treasuryId])
}

// NEW: Track national contributions from system groups
model NationalContribution {
  id              String   @id @default(uuid()) @db.Uuid
  fromGroupId     String   @db.Uuid
  toNationalId    String   @db.Uuid
  amount          Decimal  @db.Decimal(20, 2)
  sourceType      String   // DUES_PAYMENT, TREASURY_ALLOCATION, PROJECT_SURPLUS
  period          String?  // "2025-01" for monthly tracking
  metadata        Json?
  createdAt       DateTime @default(now())
  
  fromGroup       Group    @relation(fields: [fromGroupId], references: [id], onDelete: Cascade)
  
  @@index([fromGroupId])
  @@index([period])
  @@index([createdAt])
}


// ============================================================================
// PHYSICAL WORK & VERIFICATION
// ============================================================================

model PhysicalWorkLog {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  projectId         String?  @db.Uuid
  milestoneId       String?  @db.Uuid
  workType          String // MANUAL_LABOR, SKILLED_WORK, SUPERVISION
  description       String
  hours             Decimal  @db.Decimal(5, 2)
  location          Json? // Lat/lng, address
  photoUrls         String[]
  witnessIds        String[] @db.Uuid
  baseIP            Int      @default(0)
  qualityMultiplier Decimal  @db.Decimal(3, 2) @default(1.0)
  totalIPEarned     Int      @default(0)
  verifiedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone     Milestone?           @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  verifications WorkVerification[]

  @@index([userId, createdAt])
  @@index([projectId])
  @@index([milestoneId])
  @@index([verifiedAt])
}

model WorkVerification {
  id         String             @id @default(uuid()) @db.Uuid
  workLogId  String             @db.Uuid
  verifierId String             @db.Uuid
  method     VerificationMethod
  status     VerificationStatus @default(PENDING)
  notes      String?
  evidence   String[] // Additional photo URLs, documents
  verifiedAt DateTime?
  createdAt  DateTime           @default(now())

  workLog  PhysicalWorkLog @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  verifier User            @relation("WorkVerifier", fields: [verifierId], references: [id], onDelete: Cascade)

  @@unique([workLogId, verifierId])
  @@index([verifierId])
  @@index([status])
}

// ============================================================================
// UT WITHDRAWALS (fiatBackedUtBalance → M-Pesa B2C payouts)
// Rule: Only fiatBackedUtBalance is cashable. earnedUtBalance has no cash-out path.
// ============================================================================

model UtWithdrawal {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  amountKes   Int                     // 1 UT = 1 KES
  mpesaPhone  String                  // E.164 format
  status      String   @default("PENDING") // PENDING | COMPLETED | FAILED
  completedAt DateTime?
  failureNote String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@map("ut_withdrawals")
}

// ============================================================================
// COMMITMENTS (moved from base.prisma)
// Tracks formal commitments a user makes (dues, project contributions, roles)
// ============================================================================

model Commitment {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  type         String   // "DUES", "PROJECT_CONTRIBUTION", "GROUP_ROLE", "EVENT_ATTENDANCE"
  targetId     String?  @db.Uuid // Group ID, Project ID, etc.
  amountKes    Int?     // For monetary commitments
  amountPR     Int?     // For PR commitments
  frequency    String?  // "MONTHLY", "ONE_TIME", "WEEKLY"
  startDate    DateTime
  endDate      DateTime?
  status       String   // "ACTIVE", "BREACHED", "COMPLETED", "CANCELLED"
  missedCount  Int      @default(0)
  totalPaidKes Int      @default(0)
  totalPaidPR  Int      @default(0)
  breachReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, status])
  @@map("commitments")
}



// ============================================================================
// MODULE: COMMUNITY
// ============================================================================
// ============================================================================
// COMMUNITY MODULE - Groups, Assets, Conflicts
// ============================================================================

enum SystemGroupType {
  WARD
  CONSTITUENCY
  COUNTY
  NATIONAL
}

enum VoluntaryGroupType {
  // ECONOMIC
  BUSINESS_COLLECTIVE
  SAVINGS_CREDIT
  AGRICULTURE_COOPERATIVE
  TRADE_ASSOCIATION

  // PROJECT
  PROJECT_EXECUTION
  INFRASTRUCTURE_COMMITTEE
  CONSTRUCTION_TEAM

  // WELFARE
  NON_PROFIT
  COMMUNITY_WELFARE
  POVERTY_ALLEVIATION

  // PROFESSIONAL
  PROFESSIONAL_NETWORK
  EXPERT_PANEL
  QUALITY_ASSURANCE
  ACADEMIC_RESEARCH

  // EMERGENCY
  EMERGENCY_RESPONSE
  FIRST_RESPONDERS
  SECURITY_WATCH
  CRISIS_MANAGEMENT

  // DEMOGRAPHIC
  YOUTH_ORGANIZATION
  WOMEN_EMPOWERMENT
  ELDERLY_SUPPORT
  DISABILITY_ADVOCACY

  // SECTOR
  HEALTH_INITIATIVE
  EDUCATION_INITIATIVE
  ENVIRONMENTAL_GROUP
  TECHNOLOGY_HUB
  ARTS_CULTURE
  SPORTS_RECREATION

  // FAITH & CULTURE
  RELIGIOUS_ORGANIZATION
  CULTURAL_PRESERVATION
  INTERFAITH_DIALOGUE

  // ADVOCACY
  ADVOCACY_GROUP
  CIVIC_EDUCATION
  POLICY_RESEARCH
  TRANSPARENCY_WATCHDOG

  // GENERAL
  SPECIAL_INTEREST
  SOCIAL_CLUB
  ALUMNI_NETWORK
  NEIGHBORHOOD_ASSOCIATION
}

// ============================================================================
// UPDATED GROUP MODEL - Add proposal/project relations
// ============================================================================

model Group {
  id            String  @id @default(uuid()) @db.Uuid
  name          String  @unique
  description   String?
  metadata      Json?
  walletAddress String? @unique

  isSystemGroup Boolean             @default(false)
  systemType    SystemGroupType?
  voluntaryType VoluntaryGroupType?

  canBeDeleted Boolean @default(true)
  canBeRenamed Boolean @default(true)

  locationScope   LocationScope
  wardId          String?       @db.Uuid
  constituencyId  String?       @db.Uuid
  countyId        String?       @db.Uuid
  industryFocusId String?       @db.Uuid

  status          GroupStatus @default(FORMING)
  memberCount     Int         @default(0)
  treasuryBalance Decimal     @default(0) @db.Decimal(20, 2)
  lastActivity    DateTime    @default(now())
  
  contributesToNational    Boolean @default(false)
  nationalContributionRate Decimal @default(0.01) @db.Decimal(3, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ward         Ward?         @relation("GroupWard", fields: [wardId], references: [id], onDelete: SetNull)
  constituency Constituency? @relation(fields: [constituencyId], references: [id], onDelete: SetNull)
  county       County?       @relation("CountyGroups", fields: [countyId], references: [id], onDelete: SetNull)

  declaration         WardDeclaration?

  members             GroupMember[]
  proposals           Proposal[]              @relation("GroupProposals")
  votes               GroupMemberVote[]       @relation("GroupVotes")
  emergencyAlerts     EmergencyAlert[]
  marketplaceListings MarketplaceListing[]    @relation("GroupListings")
  communityAssets     CommunityAsset[]        @relation("GroupAssets")
  duesAllocations     DuesAllocation[]
  events              Event[]
  treasury            GroupTreasury[]
  treasuryPolicies    TreasuryPolicy[]
  ownedProjects       Project[]               @relation("GroupProjects") // UPDATED relation name
  elections             Election[]          @relation("GroupElections")
  nationalContributions NationalContribution[]
  barazaGroups          BarazaGroup[]

  @@index([isSystemGroup, systemType])
  @@index([isSystemGroup, voluntaryType])
  @@index([locationScope, wardId])
  @@index([status])
  @@index([contributesToNational])
}

model GroupMember {
  id   String    @id @default(uuid()) @db.Uuid
  userId   String    @db.Uuid
  groupId  String    @db.Uuid
  role     GroupRole @default(MEMBER)

  // System membership tracking
  autoEnrolled Boolean @default(false)
  canLeave     Boolean @default(true)

  joinedAt DateTime @default(now())
  active   Boolean  @default(true)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId, role])
  @@index([userId, active])
  @@index([autoEnrolled])
}

model CommunityAsset {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  description  String
  assetType    String
  ownerType    HolderType
  ownerUserId  String?    @db.Uuid
  ownerGroupId String?    @db.Uuid
  wardId       String     @db.Uuid
  location     String?
  status       String     @default("AVAILABLE")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  ward  Ward   @relation(fields: [wardId], references: [id], onDelete: Cascade)
  group Group? @relation("GroupAssets", fields: [ownerGroupId], references: [id], onDelete: SetNull)

  @@index([wardId])
  @@index([ownerGroupId])
  @@index([status])
}

model ConflictCase {
  id            String    @id @default(uuid()) @db.Uuid
  complainantId String    @db.Uuid
  respondentId  String    @db.Uuid
  description   String
  evidence      String[]
  status        String    @default("OPEN")
  mediatorId    String?   @db.Uuid
  resolution    String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  complainant User @relation("Complainant", fields: [complainantId], references: [id], onDelete: Cascade)
  respondent  User @relation("Respondent", fields: [respondentId], references: [id], onDelete: Cascade)

  @@index([complainantId])
  @@index([respondentId])
  @@index([status])
}

// ============================================================================
// ENGAGEMENT & ACTIVITY
// ============================================================================

model Activity {
  id          String         @id @default(uuid()) @db.Uuid
  actorId     String         @db.Uuid
  actorType   HolderType
  actionType  String
  entityType  String?
  entityId    String?        @db.Uuid
  scope       LocationScope?
  locationId  String?        @db.Uuid
  description String
  metadata    Json?
  isPublic    Boolean        @default(true)
  createdAt   DateTime       @default(now())

  @@index([actorId, createdAt])
  @@index([scope, locationId, createdAt])
  @@index([entityType, entityId])
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  authorId   String   @db.Uuid
  entityType String   // "PROPOSAL", "PROJECT", "MILESTONE", "LISTING", etc.
  entityId   String   @db.Uuid
  content    String   @db.Text
  parentId   String?  @db.Uuid
  upvotes    Int      @default(0)
  downvotes  Int      @default(0)
  flagged    Boolean  @default(false)
  deleted    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // RELATIONS
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentReplies")
  
  // NEW: Polymorphic relations (use entityType to determine which)
  proposal   Proposal? @relation("ProposalComments", fields: [entityId], references: [id], onDelete: Cascade, map: "comment_proposal_fk")
  project    Project?  @relation("ProjectComments", fields: [entityId], references: [id], onDelete: Cascade, map: "comment_project_fk")
  milestone  Milestone? @relation("MilestoneComments", fields: [entityId], references: [id], onDelete: Cascade, map: "comment_milestone_fk")

  @@index([entityType, entityId, createdAt])
  @@index([authorId])
  @@index([parentId])
}

model Event {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  description String
  eventType   String
  organizerId String        @db.Uuid
  groupId     String?       @db.Uuid
  scope       LocationScope
  locationId  String        @db.Uuid
  venue       String?
  virtualUrl  String?
  startTime   DateTime
  endTime     DateTime
  capacity    Int?
  attendeeCount Int         @default(0)
  status      String        @default("SCHEDULED")
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organizer User   @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  group     Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  attendees EventAttendee[]

  @@index([scope, locationId, startTime])
  @@index([status, startTime])
  @@index([organizerId])
}

model EventAttendee {
  id           String    @id @default(uuid()) @db.Uuid
  eventId      String    @db.Uuid
  userId       String    @db.Uuid
  status       String    @default("REGISTERED")
  checkedInAt  DateTime?
  registeredAt DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId, status])
}

model UserEngagementMetric {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  date             DateTime @db.Date
  proposalsVoted   Int      @default(0)
  eventsAttended   Int      @default(0)
  commentsPosted   Int      @default(0)
  timeSpentMinutes Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

// ============================================================================
// BARAZA INTEGRATION — External messaging groups (Telegram / Discord / WhatsApp)
// ============================================================================

model BarazaGroup {
  id           String            @id @default(uuid()) @db.Uuid
  groupId      String            @db.Uuid
  platform     MessagingPlatform
  externalId   String            // Telegram chat ID / Discord channel ID
  name         String            // display name on the external platform
  inviteLink   String?
  isActive     Boolean           @default(true)
  registeredBy String            @db.Uuid
  metadata     Json?             // platform extras (Discord guildId, etc.)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  group        Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendances  BarazaAttendance[]
  sessions     BarazaSession[]

  @@unique([groupId, platform, externalId])
  @@index([groupId, isActive])
  @@index([platform, externalId])
  @@map("baraza_groups")
}

model BarazaSession {
  id            String      @id @default(uuid()) @db.Uuid
  barazaGroupId String      @db.Uuid
  scheduledAt   DateTime
  openedAt      DateTime?
  closedAt      DateTime?
  createdBy     String      @db.Uuid
  reminderJobId String?     // BullMQ job ID — stored to allow future cancellation
  createdAt     DateTime    @default(now())

  barazaGroup   BarazaGroup      @relation(fields: [barazaGroupId], references: [id], onDelete: Cascade)
  attendances   BarazaAttendance[]

  @@index([barazaGroupId, scheduledAt])
  @@map("baraza_sessions")
}

model BarazaAttendance {
  id              String         @id @default(uuid()) @db.Uuid
  barazaGroupId   String         @db.Uuid
  userId          String         @db.Uuid
  barazaSessionId String?        @db.Uuid
  sessionDate     String         // "YYYY-MM-DD" — one reward per user per baraza per day
  prAwarded       Boolean        @default(false)
  prAmount        Int            @default(0)
  reportedAt      DateTime       @default(now())
  reportedBy      String?        // "telegram_bot" | "discord_bot" | "manual"

  barazaGroup     BarazaGroup    @relation(fields: [barazaGroupId], references: [id], onDelete: Cascade)
  barazaSession   BarazaSession? @relation(fields: [barazaSessionId], references: [id])
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, barazaGroupId, sessionDate])
  @@index([barazaGroupId, sessionDate])
  @@index([userId, prAwarded])
  @@map("baraza_attendance")
}

// ============================================================================
// WARD DECLARATION — Genesis document stored on group creation
// ============================================================================

model WardDeclaration {
  id              String   @id @default(uuid()) @db.Uuid
  groupId         String   @unique @db.Uuid
  wardName        String
  registeredAt    DateTime
  declarationText String   @db.Text

  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("ward_declarations")
}

// ============================================================================
// VERIFICATION & VOUCHING (moved from base.prisma)
// ============================================================================

// Tracks the multi-step community verification process for a user
model VerificationRequest {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  type            String    // "COMMUNITY"
  status          String    // "PENDING", "VOUCHING", "PAYMENT_PENDING", "APPROVED", "REJECTED", "EXPIRED"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  expiresAt       DateTime?
  rejectionReason String?
  reviewedBy      String?   @db.Uuid // Admin user ID
  reviewedAt      DateTime?

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId, status])
  @@map("verification_requests")
}

// Tracks vouches given by existing community members to new members
model CommunityVouch {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid // New user being vouched for
  voucherId String   @db.Uuid // Existing user vouching
  wardId    String   @db.Uuid // Ward where vouching happens (must match both users' ward)
  createdAt DateTime @default(now())

  user    User @relation("VouchedFor", fields: [userId], references: [id], onDelete: Cascade)
  voucher User @relation("VouchesGiven", fields: [voucherId], references: [id], onDelete: Cascade)
  ward    Ward @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([userId, voucherId]) // Prevent duplicate vouches
  @@index([userId])
  @@index([voucherId])
  @@index([wardId])
  @@map("community_vouches")
}



// ============================================================================
// MODULE: GOVERNANCE
// ============================================================================
// ============================================================================
// GOVERNANCE MODULE - Proposals, Voting, Projects
// ============================================================================

enum ProposalType {
  COMMUNITY_INITIATIVE
  MAJOR_PROJECT
  STRATEGIC_DECISION
  EMERGENCY
}

enum ProposalStatus {
  DRAFT
  PENDING_REVIEW       // LEADER forwarded — awaiting location admin approval
  APPROVED_FOR_VOTING  // Location admin approved — LEADER can open voting
  VOTING
  APPROVED
  REJECTED
  EXECUTING
  COMPLETED
  CANCELLED
}

enum ProposalScope {
  GROUP      // Internal to the voluntary group only
  COMMUNITY  // Public / community-wide
}


// ============================================================================
// UPDATED PROPOSAL MODEL - With Lean Canvas & Milestones
// ============================================================================

model Proposal {
  id                String         @id @default(uuid()) @db.Uuid
  title             String
  description       String         @db.Text
  proposalType      ProposalType
  status            ProposalStatus @default(DRAFT)
  groupId           String?        @db.Uuid
  creatorId         String         @db.Uuid
  
  // FINANCIAL
  budget            Decimal?       @db.Decimal(20, 2)
  fundingSource     String?        // GROUP_TREASURY, EXTERNAL_GRANT, MEMBER_CONTRIBUTIONS
  
  // LEAN CANVAS (All optional but recommended)
  problem           String?        @db.Text
  solution          String?        @db.Text
  keyMetrics        Json?          // [{ name, target, unit }]
  uniqueValue       String?        @db.Text
  unfairAdvantage   String?        @db.Text
  customerSegments  Json?          // [{ segment, size, description }]
  channels          Json?          // [{ name, description, reach }]
  costStructure     Json?          // [{ category, item, amount, description }]
  revenueStreams    Json?          // [{ source, amount, frequency, description }]
  
  // EXECUTION PLAN
  timeline          Json?          // Overall timeline with phases
  team              Json?          // [{ userId, role, commitment }]
  dependencies      Json?          // [{ name, description, status }]
  risks             Json?          // [{ risk, impact, mitigation }]
  
  // SCOPE & FUNDING
  proposalScope          ProposalScope  @default(COMMUNITY)
  groupFundingAmount     Decimal?       @db.Decimal(20, 2)
  locationFundingRequest Decimal?       @db.Decimal(20, 2)

  // REVIEW
  reviewedById      String?        @db.Uuid
  reviewNote        String?        @db.Text

  // VOTING
  votesFor          Int            @default(0)
  votesAgainst      Int            @default(0)
  quorum            Int            @default(0)
  approvalThreshold Int            @default(0)
  votingStartsAt    DateTime?
  votingEndsAt      DateTime?
  
  // ATTACHMENTS
  documents         String[]       // URLs to supporting docs
  images            String[]       // Proposal images

  // WARD MEMORY LAYER — reasoning, alternatives, outcomes
  rationale         String?        @db.Text  // Why this option, not others
  alternatives      String?        @db.Text  // What else was considered
  outcome           String?        @db.Text  // What actually happened after execution
  outcomeRecordedAt DateTime?                // When outcome was written

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // RELATIONS
  group              Group?              @relation("GroupProposals", fields: [groupId], references: [id], onDelete: SetNull)
  creator            User                @relation("UserProposals", fields: [creatorId], references: [id], onDelete: Cascade)
  reviewer           User?               @relation("ProposalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  votes              GroupMemberVote[]   @relation("ProposalVotes")
  walletTransactions WalletTransaction[] @relation("ProposalTransactions")
  escrows            Escrow[]            @relation("ProposalEscrows")
  milestones         ProposalMilestone[] // NEW
  project            Project?            @relation("ProposalToProject") // NEW
  comments           Comment[]           @relation("ProposalComments") // NEW

  @@index([groupId, status])
  @@index([creatorId])
  @@index([reviewedById])
  @@index([status, votingEndsAt])
  @@index([proposalType])
}

// ============================================================================
// NEW: PROPOSAL MILESTONES
// ============================================================================

model ProposalMilestone {
  id             String   @id @default(uuid()) @db.Uuid
  proposalId     String   @db.Uuid
  title          String
  description    String   @db.Text
  
  // Deliverables
  deliverables   Json     // [{ description, quantity, unit }]
  
  // Resources needed
  budgetAmount   Decimal  @db.Decimal(20, 2)
  laborHours     Int?
  materials      Json?    // [{ item, quantity, cost, unit }]
  
  // Timeline
  startOffset    Int      // Days from project start
  duration       Int      // Days to complete
  dependencies   String[] @db.Uuid  // IDs of previous milestones in this proposal
  
  // Verification requirements
  verificationMethod   String  // PEER, SUPERVISOR, COMMUNITY_WITNESS, PHOTO_EVIDENCE
  verifiersNeeded      Int     @default(1)
  verificationCriteria Json    // [{ criterion, description, required }]
  
  // Order
  orderIndex     Int      @default(0)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // RELATIONS
  proposal         Proposal   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  projectMilestone Milestone? @relation("ProposalToProjectMilestone")
  
  @@index([proposalId])
  @@index([orderIndex])
}


model GroupMemberVote {
 id         String   @id @default(uuid()) @db.Uuid
 groupId    String   @db.Uuid
 memberId   String   @db.Uuid
 proposalId String   @db.Uuid
 vote       Boolean?
 voteWeight Int      @default(1)
 comment    String?
 createdAt  DateTime @default(now())
 group    Group    @relation("GroupVotes", fields: [groupId], references: [id], onDelete: Cascade)
 member   User     @relation("UserVotes", fields: [memberId], references: [id], onDelete: Cascade)
 proposal Proposal @relation("ProposalVotes", fields: [proposalId], references: [id], onDelete: Cascade)
 @@unique([groupId, memberId, proposalId])
 @@index([proposalId])
 @@index([memberId])
}



// ============================================================================
// MODULE: ELECTIONS
// ============================================================================
// ============================================================================
// ELECTIONS MODULE
// Democratic elections for ELECTED roles (GroupRoleAssignment + SystemRoleAssignment).
// Gated: first election only after membership threshold is reached.
// ============================================================================

model Election {
  id       String @id @default(uuid()) @db.Uuid

  // What role is being elected
  roleKey  String // e.g. "LEADER", "TREASURER", "AUDITOR", "COUNTY_COORDINATOR"

  // Scope: GROUP (group-level) or SYSTEM (platform-level)
  scope    String // 'GROUP' | 'SYSTEM'

  // Scope references (mutually exclusive)
  groupId  String? @db.Uuid
  countyId String? @db.Uuid

  status   String @default("PENDING")
  // PENDING | NOMINATIONS_OPEN | VOTING_OPEN | CLOSED

  // Window configuration
  nominationsOpenAt  DateTime
  nominationsCloseAt DateTime
  votingOpenAt       DateTime
  votingCloseAt      DateTime

  // Outcome
  winnerId        String? @db.Uuid
  totalVoteWeight Int     @default(0)
  quorumReached   Boolean @default(false)

  // Term configuration
  termMonths    Int       @default(12)
  nextElectionAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  group      Group?              @relation("GroupElections", fields: [groupId], references: [id], onDelete: SetNull)
  county     County?             @relation("CountyElections", fields: [countyId], references: [id], onDelete: SetNull)
  winner     User?               @relation("ElectionWinners", fields: [winnerId], references: [id], onDelete: SetNull)
  candidates ElectionCandidate[]
  votes      ElectionVote[]

  @@index([groupId, status])
  @@index([scope, status])
  @@index([countyId, status])
  @@index([votingCloseAt])
  @@index([nominationsOpenAt])
  @@map("elections")
}

model ElectionCandidate {
  id         String    @id @default(uuid()) @db.Uuid
  electionId String    @db.Uuid
  userId     String    @db.Uuid

  statement   String?   @db.Text
  totalWeight Int       @default(0)
  voteCount   Int       @default(0)
  nominatedAt DateTime  @default(now())
  withdrawnAt DateTime?

  election Election      @relation(fields: [electionId], references: [id], onDelete: Cascade)
  user     User          @relation("ElectionCandidates", fields: [userId], references: [id], onDelete: Cascade)
  votes    ElectionVote[]

  @@unique([electionId, userId])
  @@index([electionId])
  @@index([userId])
  @@map("election_candidates")
}

model ElectionVote {
  id          String   @id @default(uuid()) @db.Uuid
  electionId  String   @db.Uuid
  candidateId String   @db.Uuid
  voterId     String   @db.Uuid

  // PR balance snapshot at time of vote — locked for tally
  weight Int

  castAt DateTime @default(now())

  election  Election          @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidate ElectionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  voter     User              @relation("ElectionVoters", fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([electionId, voterId]) // one vote per election per voter
  @@index([electionId])
  @@index([candidateId])
  @@index([voterId])
  @@map("election_votes")
}



// ============================================================================
// MODULE: PROJECTS
