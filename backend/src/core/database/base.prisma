// Verification requests (tracks vouching/payment progress)
model VerificationRequest {
  id            String   @id @default(uuid())
  userId        String
  type          String   // "COMMUNITY"
  status        String   // "PENDING", "VOUCHING", "PAYMENT_PENDING", "APPROVED", "REJECTED", "EXPIRED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  expiresAt     DateTime?
  rejectionReason String?
  reviewedBy    String?  // Admin user ID
  reviewedAt    DateTime?

  user          User     @relation(fields: [userId], references: [id])

  @@unique([userId, type])
}

// Vouch tracking
model CommunityVouch {
  id            String   @id @default(uuid())
  userId        String   // New user being vouched for
  voucherId     String   // Existing user vouching
  wardId        String   // Ward where vouching happens (must match)
  createdAt     DateTime @default(now())

  user          User     @relation("VouchedFor", fields: [userId], references: [id])
  voucher       User     @relation("VouchesGiven", fields: [voucherId], references: [id])
  ward          Ward     @relation(fields: [wardId], references: [id])

  @@unique([userId, voucherId])  // Prevent duplicate vouches
}

model Commitment {
  id              String   @id @default(uuid())
  userId          String
  type            String   // "DUES", "PROJECT_CONTRIBUTION", "GROUP_ROLE", "EVENT_ATTENDANCE"
  targetId        String?  // Group ID, Project ID, etc.
  amountKes       Int?     // For monetary commitments
  amountPR        Int?     // For PR commitments
  frequency       String?  // "MONTHLY", "ONE_TIME", "WEEKLY"
  startDate       DateTime
  endDate         DateTime?
  status          String   // "ACTIVE", "BREACHED", "COMPLETED", "CANCELLED"
  missedCount     Int      @default(0)
  totalPaidKes    Int      @default(0)
  totalPaidPR     Int      @default(0)
  breachReason    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])

  @@index([userId, type, status])
}