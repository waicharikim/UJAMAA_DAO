// ============================================================================
// AUTH MODULE - Authentication & Session Management
// ============================================================================

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  token        String    @unique
  deviceName   String?   @db.VarChar(100)
  deviceInfo   String?   @db.VarChar(500)
  ipAddress    String?   @db.VarChar(45)
  userAgent    String?   @db.Text
  isTrusted    Boolean   @default(false)
  lastActive   DateTime  @default(now())
  expiresAt    DateTime
  revoked      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revoked])
  @@index([token])
  @@index([expiresAt])
  @@index([lastActive])
  @@map("sessions")
}

model Account {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  provider          String    // "google", "twitter", "facebook", etc.
  providerAccountId String
  accessToken       String?   @db.Text
  refreshToken      String?   @db.Text
  expiresAt         DateTime?
  tokenType         String?
  scope             String?
  idToken           String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model RecoveryRequest {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  recoveryMethod   String   // "EMAIL", "WALLET", "RECOVERY_WALLET"
  verificationCode String   @unique
  status           String   @default("PENDING")
  expiresAt        DateTime
  completedAt      DateTime?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([verificationCode])
  @@index([expiresAt])
  @@map("recovery_requests")
}

model LoginEvent {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  method        String    // "MAGIC_LINK", "WALLET", "OAUTH"
  ipAddress     String?
  userAgent     String?
  location      String?
  successful    Boolean
  failureReason String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([successful])
  @@index([createdAt])
  @@map("login_events")
}

model PhoneVerification {
  id          String    @id @default(uuid()) @db.Uuid
  phoneNumber String    @db.VarChar(15)
  code        String    @db.VarChar(6)
  userId      String?   @db.Uuid
  verified    Boolean   @default(false)
  verifiedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([phoneNumber, verified])
  @@index([phoneNumber])
  @@index([verified])
  @@index([expiresAt])
  @@index([userId])
  @@map("phone_verifications")
}

// ============================================================================
// PASSWORD RESET (Admin only)
// ============================================================================

model PasswordReset {
  id        String   @id @default(cuid())

  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tokenHash String   @db.Text  // Hashed token (never store plaintext)
  
  used      Boolean  @default(false)
  usedAt    DateTime?

  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tokenHash, used, expiresAt])
  @@index([userId])
  @@index([expiresAt]) // For cleanup
  @@map("password_resets")
}

// ============================================================================
// TOTP 2FA (Google Authenticator)
// ============================================================================

model TwoFactorAuth {
  id                      String   @id @default(cuid())
  
  userId                  String   @unique @db.Uuid
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // TOTP secret (encrypted)
  secretEncrypted         String   @db.Text
  
  // Backup codes (encrypted array)
  backupCodesEncrypted    String[] // Each is an encrypted backup code
  
  enabled                 Boolean  @default(false)
  enabledAt               DateTime?
  disabledAt              DateTime?

  failedAttempts          Int      @default(0)
  lastFailedAttempt       DateTime?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([userId, enabled])
  @@map("two_factor_auth")
}

// ============================================================================
// WEBAUTHN / PASSKEYS (Biometric, Security Keys)
// ============================================================================

model WebAuthnCredential {
  id            String   @id @default(cuid())
  
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // WebAuthn credential data
  credentialId  String   @unique  // Base64url encoded credential ID
  publicKey     String   @db.Text // Base64url encoded public key
  counter       BigInt   @default(0) // Signature counter for replay protection
  
  // Credential metadata
  credentialName String?  @db.VarChar(100) // User-friendly name "Touch ID", "YubiKey"
  aaguid        String?  @db.VarChar(36)  // Authenticator GUID
  
  // Device info
  transports    String[] // ["usb", "nfc", "ble", "internal"]
  
  // Timestamps
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())
  
  @@index([userId])
  @@index([credentialId])
  @@map("webauthn_credentials")
}

// ============================================================================
// MAGIC LINK TOKENS (with expiry)
// ============================================================================

model MagicLinkToken {
  id        String   @id @default(cuid())
  
  email     String   @db.VarChar(255)
  tokenHash String   @unique @db.Text // Hashed token
  
  type      String   @db.VarChar(20) // "verification" or "login"
  
  used      Boolean  @default(false)
  usedAt    DateTime?
  
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([tokenHash, used, expiresAt])
  @@index([email])
  @@index([expiresAt]) // For cleanup
  @@map("magic_link_tokens")
}

// ============================================================================
// ACCOUNT RECOVERY (Trusted contacts, recovery codes)
// ============================================================================

model AccountRecovery {
  id                  String   @id @default(cuid())
  
  userId              String   @unique @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Recovery codes (encrypted, like 2FA backup codes but more)
  recoveryCodesEncrypted String[] // 20 codes for account recovery
  
  // Trusted contacts (email addresses that can help recover account)
  trustedContactEmails   String[] // Up to 3 trusted contacts
  
  // Recovery email (different from primary)
  recoveryEmail       String?  @db.VarChar(255)
  recoveryEmailVerified Boolean @default(false)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@index([userId])
  @@map("account_recovery")
}

// ============================================================================
// SECURITY EVENTS (Audit log for suspicious activity)
// ============================================================================

model SecurityEvent {
  id          String   @id @default(cuid())
  
  userId      String?  @db.Uuid // Nullable for failed login attempts
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  eventType       String   @db.VarChar(50) // "login_failed", "password_reset", "2fa_disabled", etc.
  severity        String   @db.VarChar(20) // "low", "medium", "high", "critical"
  description     String?  @db.Text

  ipAddress       String?  @db.VarChar(45)
  userAgent       String?  @db.Text
  location        String?  @db.VarChar(100) // City, Country

  metadata        Json?    // Additional context

  resolved        Boolean  @default(false)
  resolvedAt      DateTime?
  resolvedBy      String?  @db.Uuid // Admin user ID
  resolutionNotes String?  @db.Text

  createdAt       DateTime @default(now())
  
  @@index([userId, createdAt])
  @@index([eventType, severity])
  @@index([createdAt])
  @@map("security_events")
}