# .env.production

# JWT Security (updated)
JWT_SECRET=<64+ character secure random string>
JWT_ISSUER=ujamaadao.org
JWT_AUDIENCE=ujamaadao-api

# Encryption
ENCRYPTION_KEY=<64 hex characters>

# Redis (for token revocation)
REDIS_URL=redis://your-redis-host:6379

# CORS
CORS_ORIGIN=https://app.ujamaadao.org
ALLOWED_ORIGINS=https://app.ujamaadao.org,https://www.ujamaadao.org

# Web3
WEB3_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_IDs