{
  "name": "ujamaadao-backend",
  "version": "1.0.0",
  "description": "UjamaaDAO Backend - Multi-level governance platform",
  "main": "dist/index.js",
  "type": "module",
  "keywords": [
    "dao",
    "governance",
    "blockchain",
    "web3"
  ],
  "author": "UjamaaDAO Team",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/workers.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:worker\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/workers.js",
    "start:all": "concurrently \"npm start\" \"npm run start:worker\"",
    "db:merge": "tsx src/core/database/mergeSchema.ts",
    "db:generate": "npm run db:merge && prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "npm run db:merge && prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:deploy": "npm run db:merge && prisma migrate deploy --schema=prisma/schema.prisma",
    "db:push": "npm run db:merge && prisma db push --schema=prisma/schema.prisma",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "db:seed": "tsx src/core/database/seed.ts",
    "db:seed:dev": "NODE_ENV=development SEED_TEST_DATA=true tsx src/core/database/seed.ts",
    "db:seed:prod": "NODE_ENV=production SEED_TEST_DATA=false FORCE_SEED=true tsx src/core/database/seed.ts",
    "db:seed:prod:confirm": "echo 'WARNING: This will reseed production data!' && read -p 'Type YES to continue: ' confirm && [ \"$confirm\" = 'YES' ] && NODE_ENV=production SEED_TEST_DATA=false FORCE_SEED=true tsx src/core/database/seed.ts || echo 'Aborted.'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:activity": "vitest run tests/user.activity.test.ts",
    "test:full": "npm run test:unit && npm run test:integration && npm run test:activity",
    "test:setup": "docker exec -it ujamaa_postgres createdb -U ujamaa_user ujamaa_test_db || echo 'Test DB already exists'",
    "test:push": "DATABASE_URL='postgresql://ujamaa_user:ujamaa_pass@localhost:5432/ujamaa_test_db' npm run db:push",
    "test:docker": "docker exec -it ujamaa_web npm test",
    "lint": "eslint 'src/**/*.{ts,js}'",
    "lint:fix": "eslint 'src/**/*.{ts,js}' --fix",
    "format": "prettier --write 'src/**/*.{ts,js,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,js,json}'",
    "type-check": "tsc --noEmit",
    "docker:dev": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker-compose build",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@prisma/config": "^7.2.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/file-type": "^10.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.19.1",
    "@types/node-cache": "^4.1.3",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "glob": "^10.4.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "prisma": "^7.2.0",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@bull-board/api": "^6.17.0",
    "@bull-board/express": "^6.17.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@sentry/node": "^10.52.0",
    "@simplewebauthn/server": "^13.3.0",
    "@types/speakeasy": "^2.0.10",
    "africastalking": "^0.5.9",
    "argon2": "^0.44.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.67.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "ethers": "^6.14.1",
    "express": "^5.1.0",
    "express-rate-limit": "^6.11.2",
    "file-type": "^20.5.0",
    "flutterwave-node-v3": "^1.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.11",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.10.0",
    "speakeasy": "^2.0.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.24.4"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.json": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
