# ─────────────────────────────────────────────────────────────────────────────
# UjamaaDAO Backend — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# Generate secrets: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# REQUIRED in production (min 32 chars, unique per environment)
JWT_SECRET=generate_with_openssl_rand_hex_32

# REQUIRED for all crypto/encryption operations (min 32 chars)
ENCRYPTION_KEY=generate_with_openssl_rand_hex_32

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ujamaa_user:ujamaa_pass@postgres:5432/ujamaa_db
POSTGRES_USER=ujamaa_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=ujamaa_db

# ── Redis ─────────────────────────────────────────────────────────────────────
# REDIS_URL    — used by rate-limiter middleware (redis npm package)
# REDIS_HOST / REDIS_PORT — used by BullMQ queues (ioredis)
# Both must point to the same Redis instance.
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ── URLs & CORS ──────────────────────────────────────────────────────────────
BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Dev: point at MailHog (mailhog:1025, no auth needed)
# Prod: use a real SMTP provider
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ujamaadao.org

# ── SMS / Africa's Talking ────────────────────────────────────────────────────
ENABLE_SMS=false
SMS_PROVIDER=africastalking
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=

# ── Admin / Dashboard ────────────────────────────────────────────────────────
DASHBOARD_PASSWORD=change_me_in_production

# ── Observability (Version B — uncomment when enabling full stack) ────────────
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=admin
# STATSD_HOST=web-metrics
# STATSD_PORT=8125
